#!/bin/bash
# Atomic manager for the OVH gateway's static 1:1/RDP mapping table.
set -euo pipefail

MAP=/etc/wireguard/anh-xa-ip.txt
PROTECTED=/etc/ltt-vps/protected-gwnat.conf
NETPLAN=/etc/netplan/60-ip-bo-sung.yaml
NFT_CONFIG=/etc/nftables.conf
LOCK=/run/lock/ltt-gwnat.lock
WAN=ens3

fail() { echo "gwnat: $1" >&2; exit "${2:-2}"; }
ipv4() {
    local ip=$1 part
    [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r -a parts <<< "$ip"
    for part in "${parts[@]}"; do
        ((10#$part >= 0 && 10#$part <= 255)) || return 1
    done
}
validate_map() {
    local file=$1 private public owner extra
    declare -A seen_private=() seen_public=()
    while read -r private public owner extra; do
        [[ -n ${private:-} ]] || continue
        [[ $private == \#* ]] && continue
        [[ -n ${public:-} && -n ${owner:-} && -z ${extra:-} ]] || fail "invalid mapping row"
        ipv4 "$private" && ipv4 "$public" || fail "invalid IPv4 in mapping"
        [[ $owner =~ ^[A-Za-z0-9_-]{1,64}$ ]] || fail "invalid mapping owner"
        [[ -z ${seen_private[$private]+x} && -z ${seen_public[$public]+x} ]] || fail "duplicate mapping"
        seen_private[$private]=1
        seen_public[$public]=1
    done < "$file"
}
render_netplan() {
    local source=$1 target=$2 private public owner
    {
        echo '# Generated by ltt-gwnat from anh-xa-ip.txt.'
        echo 'network:'
        echo '  version: 2'
        echo '  ethernets:'
        echo "    $WAN:"
        echo '      addresses:'
        while read -r private public owner; do
            [[ -n ${private:-} && $private != \#* ]] || continue
            echo "        - $public/32"
        done < "$source"
    } > "$target"
}
render_nft_transaction() {
    local source=$1 target=$2 private public owner
    {
        echo 'delete table ip gwnat'
        echo 'table ip gwnat {'
        echo ' chain prerouting {'
        echo '  type nat hook prerouting priority dstnat; policy accept;'
        while read -r private public owner; do
            [[ -n ${private:-} && $private != \#* ]] || continue
            echo "  ip daddr $public tcp dport 3389 dnat to $private:3389 comment \"$owner tcp\""
            echo "  ip daddr $public udp dport 3389 dnat to $private:3389 comment \"$owner udp\""
        done < "$source"
        echo ' }'
        echo ' chain postrouting {'
        echo '  type nat hook postrouting priority srcnat; policy accept;'
        while read -r private public owner; do
            [[ -n ${private:-} && $private != \#* ]] || continue
            echo "  ip saddr $private oifname \"$WAN\" snat to $public comment \"$owner\""
        done < "$source"
        echo ' }'
        echo '}'
    } > "$target"
}
mapping_for_public() { awk -v ip="$1" 'NF == 3 && $1 !~ /^#/ && $2 == ip {print $1; exit}' "$MAP"; }
mapping_for_private() { awk -v ip="$1" 'NF == 3 && $1 !~ /^#/ && $1 == ip {print $2; exit}' "$MAP"; }
is_protected() { awk -v a="$1" -v b="$2" 'NF == 3 && $1 == b && $2 == a {found=1} END {exit !found}' "$PROTECTED"; }
# Any use of a protected address, in either column, not only the exact pair.
touches_protected() { awk -v a="$1" -v b="$2" 'NF == 3 && $1 !~ /^#/ && ($2 == a || $1 == b) {found=1} END {exit !found}' "$PROTECTED"; }
# The whole table is rebuilt from the candidate map, so a protected row that is
# missing from it would silently lose its live NAT rules. Refuse instead.
keeps_every_protected_row() {
    awk 'FNR == NR { if (NF == 3 && $1 !~ /^#/) want[$1 " " $2] = 1; next }
         NF == 3 && $1 !~ /^#/ { delete want[$1 " " $2] }
         END { for (k in want) exit 1 }' "$PROTECTED" "$1"
}

# --- Dem byte theo tung may khach (R26) ------------------------------------
#
# ⛔ Bo dem KHONG duoc dat trong table `gwnat`, vi hai ly do doc lap:
#
#   1. `render_nft_transaction` XOA VA DUNG LAI ca table moi lan mapping doi
#      (`delete table ip gwnat`) ⇒ moi lan mot khach mua may la moi bo dem ve 0.
#   2. Quan trong hon: chain `nat` chi thay GOI DAU TIEN cua moi ket noi
#      (conntrack). Mot `counter` dat trong do dem SO KET NOI, khong phai byte —
#      no se cho ra mot con so gan 0 trong khi trong nhu da sua xong.
#
# ⇒ Mot table RIENG, chain `filter hook forward` (thay MOI goi), `policy accept`
#   va CHI co rule counter ⇒ khong the lam roi mot goi nao.
#
# ⛔ `ensure_dem` khong bao gio XOA table: xoa la mat het byte da dem. No chi
#    THEM rule con thieu, nen chay lai nhieu lan la an toan.
DEM_TABLE=ltt_dem

ensure_dem() {
    local hien private public owner
    if ! nft list table ip "$DEM_TABLE" >/dev/null 2>&1; then
        nft add table ip "$DEM_TABLE"
        nft add chain ip "$DEM_TABLE" dem '{ type filter hook forward priority 0; policy accept; }'
    fi
    hien=$(nft list chain ip "$DEM_TABLE" dem)
    while read -r private public owner; do
        [[ -n ${private:-} && $private != \#* ]] || continue
        grep -F "\"$private len\"" <<< "$hien" >/dev/null             || nft add rule ip "$DEM_TABLE" dem ip saddr "$private" counter comment "\"$private len\""
        grep -F "\"$private xuong\"" <<< "$hien" >/dev/null             || nft add rule ip "$DEM_TABLE" dem ip daddr "$private" counter comment "\"$private xuong\""
    done < "$MAP"
}

action=${1:-}
case "$action" in
list)
    validate_map "$MAP"
    cat "$MAP"
    ;;
health)
    validate_map "$MAP"
    addresses=$(ip -4 addr show dev "$WAN")
    prerouting=$(nft list chain ip gwnat prerouting)
    postrouting=$(nft list chain ip gwnat postrouting)
    while read -r private public owner; do
        [[ -n ${private:-} && $private != \#* ]] || continue
        grep -F " $public/32 " <<< "$addresses" >/dev/null || fail "public IP missing"
        grep -F "ip daddr $public tcp dport 3389 dnat to $private:3389" <<< "$prerouting" >/dev/null || fail "TCP DNAT missing"
        grep -F "ip daddr $public udp dport 3389 dnat to $private:3389" <<< "$prerouting" >/dev/null || fail "UDP DNAT missing"
        grep -F "ip saddr $private oifname \"$WAN\" snat to $public" <<< "$postrouting" >/dev/null || fail "SNAT missing"
    done < "$MAP"
    echo ok
    ;;
ensure|remove)
    [[ $# == 3 ]] || fail "usage: ltt-gwnat $action PUBLIC PRIVATE"
    public=$2 private=$3
    ipv4 "$public" && ipv4 "$private" || fail "invalid IPv4"
    [[ -s $PROTECTED ]] || fail "protected baseline is unavailable"
    exec 9>"$LOCK"
    flock -x 9
    validate_map "$MAP"
    validate_map "$PROTECTED"
    nft list table ip gwnat >/dev/null || fail "gwnat table is unavailable"
    current_private=$(mapping_for_public "$public")
    current_public=$(mapping_for_private "$private")
    keeps_every_protected_row "$MAP" || fail "current map is missing a protected mapping" 5
    if [[ $action == ensure ]]; then
        touches_protected "$public" "$private" && fail "protected address cannot be assigned" 5
        [[ -z $current_private || $current_private == "$private" ]] || fail "public IP belongs to another mapping" 4
        [[ -z $current_public || $current_public == "$public" ]] || fail "private IP belongs to another mapping" 4
        [[ $current_private == "$private" ]] && { echo ok; exit 0; }
    else
        [[ -n $current_private ]] || { echo ok; exit 0; }
        [[ $current_private == "$private" ]] || fail "mapping ownership conflict" 4
        is_protected "$public" "$private" && fail "protected mapping cannot be removed" 5
    fi

    work=$(mktemp -d /run/ltt-gwnat.XXXXXX)
    cleanup() {
        case "$work" in /run/ltt-gwnat.*) rm -rf -- "$work" ;; esac
    }
    trap cleanup EXIT
    if [[ $action == ensure ]]; then
        cp "$MAP" "$work/map"
        echo "$private $public LTTMANAGED" >> "$work/map"
    else
        awk -v a="$public" -v b="$private" '!(NF == 3 && $1 == b && $2 == a)' "$MAP" > "$work/map"
    fi
    validate_map "$work/map"
    keeps_every_protected_row "$work/map" || fail "change would drop a protected mapping" 5
    render_netplan "$work/map" "$work/netplan"
    render_nft_transaction "$work/map" "$work/nft-transaction"
    nft -c -f "$work/nft-transaction"
    { echo 'flush ruleset'; nft list ruleset; } > "$work/old-rules"
    cp "$MAP" "$work/old-map"
    cp "$NETPLAN" "$work/old-netplan"
    cp "$NFT_CONFIG" "$work/old-nft-config"

    rollback() {
        nft -f "$work/old-rules" >/dev/null 2>&1 || true
        cp "$work/old-map" "$MAP" || true
        cp "$work/old-netplan" "$NETPLAN" || true
        cp "$work/old-nft-config" "$NFT_CONFIG" || true
        if [[ $action == ensure ]]; then ip addr del "$public/32" dev "$WAN" 2>/dev/null || true
        else ip addr replace "$public/32" dev "$WAN" 2>/dev/null || true; fi
    }
    trap 'rollback; exit 6' ERR
    nft -f "$work/nft-transaction"
    if [[ $action == ensure ]]; then ip addr replace "$public/32" dev "$WAN"
    else ip addr del "$public/32" dev "$WAN" 2>/dev/null || true; fi
    { echo 'flush ruleset'; nft list ruleset; } > "$work/new-nft-config"
    nft -c -f "$work/new-nft-config"
    install -m 600 "$work/map" "$MAP"
    install -m 600 "$work/netplan" "$NETPLAN"
    install -m 644 "$work/new-nft-config" "$NFT_CONFIG"
    trap - ERR
    echo ok
    ;;
dem)
    # In JSON, KHONG in van ban nguoi-doc: mot phep do parse dinh dang nguoi-doc
    # se chet im lang khi dinh dang doi (da mat mot ngay vi `nslookup` 25/09).
    validate_map "$MAP"
    ensure_dem
    nft -j list chain ip "$DEM_TABLE" dem
    ;;
*) fail 'usage: ltt-gwnat {health|list|ensure|remove|dem}' ;;
esac
