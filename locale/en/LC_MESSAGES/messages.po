msgstr "Open this page in Safari — other browsers cannot install it."

msgid "LTT Nexus — điều khiển máy tính từ xa"
msgstr "LTT Nexus — remote control for your computers"

msgid "Điều khiển máy tính của bạn từ bất kỳ đâu — từ máy khác, từ điện thoại. Cài ứng dụng, đăng nhập cùng một tài khoản LTT, máy hiện ra là bấm vào dùng."
msgstr "Reach your computer from anywhere — from another machine or from your phone. Install the app, sign in with the same LTT account, and your machines are one click away."

msgid "Tải ứng dụng"
msgstr "Download the app"

msgid "Vì sao dùng LTT Nexus"
msgstr "Why LTT Nexus"

msgid "Không cần cấu hình mạng"
