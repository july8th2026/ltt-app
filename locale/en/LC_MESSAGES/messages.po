msgid "Phiên làm việc được lưu trên máy, nên bạn có thể quay lại một phiên trước đó và làm tiếp."
msgstr "Sessions are saved on your computer, so you can go back to an earlier session and continue."

msgid "Bốn bước để bắt đầu"
msgstr "Four steps to get started"

msgid "Bấm Tải cho Windows ở đầu trang. Cần Windows 10 hoặc 11 bản 64-bit."
msgstr "Click Download for Windows at the top of this page. Requires 64-bit Windows 10 or 11."

msgid "Cài đặt"
msgstr "Install"

msgid "Chạy tệp vừa tải. Bộ cài chưa ký số nên Windows SmartScreen có thể cảnh báo: chọn Thông tin thêm rồi Vẫn chạy."
msgstr "Run the downloaded file. The installer is not code-signed yet, so Windows SmartScreen may warn you: choose More info, then Run anyway."

msgid "Đăng nhập tài khoản LTT"
msgstr "Sign in to your LTT account"

msgid "Bấm Đăng nhập trong ứng dụng. Trình duyệt mở trang xác nhận — bấm Cho phép trong vòng 5 phút."
msgstr "Click Sign in in the app. Your browser opens a confirmation page — click Allow within 5 minutes."

msgid "Mở thư mục dự án"
msgstr "Open your project folder"

msgid "Chọn thư mục mã nguồn làm workspace rồi bắt đầu trò chuyện với trợ lý."
msgstr "Choose your source code folder as the workspace and start chatting with the assistant."

msgid "Chưa có tài khoản LTT?"
msgstr "No LTT account yet?"

msgid "Trợ lý chỉ làm những gì bạn cho phép"
msgstr "The assistant only does what you allow"

msgid "Một công cụ được sửa tệp và chạy lệnh trên máy bạn nợ bạn câu trả lời rõ ràng về giới hạn của nó."
msgstr "A tool that edits files and runs commands on your computer owes you a clear answer about its limits."

msgid "Khoá riêng cho từng máy"
msgstr "A separate key for each device"

msgid "Khi đăng nhập, nền tảng cấp một khoá riêng cho máy này; ứng dụng lưu nó trong Windows Credential Manager. Đăng xuất là khoá bị thu hồi."
msgstr "When you sign in, the platform issues a key for this device only; the app stores it in Windows Credential Manager. Signing out revokes the key."

msgid "Trợ lý làm việc trong thư mục bạn chọn. Lệnh nào chạm ra ngoài đều chờ bạn đồng ý, và quyền truy cập đầy đủ được hỏi cho từng lệnh."
msgstr "The assistant works inside the folder you choose. Any command that reaches outside waits for your consent, and full access is requested for each command."

msgid "Chỉ kết nối tới LTT"
msgstr "Connects only to LTT"

msgid "Ứng dụng gửi yêu cầu tới máy chủ LTT Studios để gọi model và tìm web; nó không tự gửi mã của bạn tới dịch vụ bên thứ ba nào."
msgstr "The app sends requests to LTT Studios servers to call models and search the web; it does not send your code to any third-party service on its own."

msgid "Trước khi cài bản mới, ứng dụng kiểm chữ ký của gói cập nhật. Gói sai chữ ký bị từ chối."
msgstr "Before installing a new version, the app verifies the update package's signature. A package with a bad signature is rejected."

msgid "Trả theo lượt dùng model"
msgstr "Pay per model use"

msgid "Tải và cài LTTCODE không mất phí. Mỗi lượt trợ lý dùng model sẽ trừ credit trong tài khoản LTT của bạn, theo bảng giá model của nền tảng."
msgstr "Downloading and installing LTTCODE is free. Each time the assistant uses a model, credits are deducted from your LTT account according to the platform's model pricing."

msgid "Xem bảng giá model"
msgstr "View model pricing"

msgid "Cập nhật & gỡ cài đặt"
msgstr "Updates & uninstalling"

msgid "Luôn ở bản mới nhất"
msgstr "Always on the latest version"

msgid "Tự báo khi có bản mới"
msgstr "Tells you when a new version is out"

msgid "Ứng dụng kiểm tra bản mới khi khởi động và sáu giờ một lần. Khi có bản mới, bấm Cập nhật ngay để tải và cài; gói cập nhật được kiểm chữ ký trước khi cài."
msgstr "The app checks for a new version at startup and every six hours. When one is available, click Update now to download and install it; the update package is signature-verified before it is installed."

msgid "Gỡ cài đặt"
msgstr "Uninstall"

msgid "Mở Settings › Apps của Windows (Cài đặt › Ứng dụng), tìm LTTCODE rồi chọn Gỡ cài đặt."
msgstr "Open Windows Settings › Apps, find LTTCODE and choose Uninstall."

msgid "Xử lý sự cố"
msgstr "Troubleshooting"

msgid "Windows SmartScreen chặn bộ cài"
msgstr "Windows SmartScreen blocks the installer"

msgid "Bộ cài hiện chưa được ký số nên SmartScreen chưa nhận ra nó. Chọn Thông tin thêm rồi Vẫn chạy. Muốn chắc tệp không bị thay đổi, so mã SHA-256 ở đầu trang với tệp bạn đã tải."
msgstr "The installer is not code-signed yet, so SmartScreen does not recognize it. Choose More info, then Run anyway. To make sure the file was not altered, compare the SHA-256 at the top of this page with the file you downloaded."

msgid "Đăng nhập chờ quá lâu rồi thất bại"
msgstr "Sign-in waited too long and failed"

msgid "Ứng dụng chỉ chờ bạn bấm Cho phép trong trình duyệt tối đa 5 phút. Quá thời gian đó, hoặc lỡ đóng trang, hãy quay lại ứng dụng và bấm Đăng nhập lần nữa."
msgstr "The app waits at most 5 minutes for you to click Allow in the browser. If that time passes, or you closed the page, go back to the app and click Sign in again."

msgid "Trợ lý không khởi động được"
msgstr "The assistant does not start"

msgid "Phần runtime của trợ lý (DeepSeek-Harness) chạy ngay trên máy bạn. Nếu nó không khởi động, ứng dụng hiện nút mở nhật ký để bạn xem lỗi cụ thể."
msgstr "The assistant's runtime (DeepSeek-Harness) runs on your own computer. If it fails to start, the app shows a button to open the log so you can see the exact error."

msgid "Mất máy, hoặc muốn cắt quyền của một máy"
msgstr "Lost a device, or want to cut off a device's access"

msgid "Đăng nhập trang web, vào Developers › Keys và thu hồi khoá của máy đó. Khoá bị thu hồi thì máy ấy không dùng được tài khoản của bạn nữa."
msgstr "Sign in on the website, go to Developers › Keys and revoke that device's key. Once the key is revoked, that device can no longer use your account."

msgid "Mở Developers › Keys"
msgstr "Open Developers › Keys"

msgid "Yêu cầu hệ thống"
msgstr "System requirements"

msgid "Windows 10 hoặc Windows 11 bản 64-bit (x64), có kết nối Internet và một tài khoản LTT còn credit."
msgstr "64-bit (x64) Windows 10 or Windows 11, an Internet connection and an LTT account with credits."

msgid "Sẵn sàng thử LTTCODE?"
msgstr "Ready to try LTTCODE?"

msgid "Tải bộ cài, đăng nhập tài khoản LTT và mở thư mục dự án đầu tiên của bạn."
msgstr "Download the installer, sign in to your LTT account and open your first project folder."

msgid "Mục trong ứng dụng"
msgstr "Sections in this app"

msgid "Email hoặc tên đăng nhập"
msgstr "Email or username"

msgid "Nhập email của bạn"
msgstr "Enter your email"

msgid "Mở ứng dụng"
msgstr "Open app"

msgid "Tìm ứng dụng…"
msgstr "Search apps…"

msgid "Điều khiển máy tính của bạn từ xa — không mở cổng, không cần IP tĩnh. Cài ứng dụng, đăng nhập cùng tài khoản, máy hiện ra là bấm vào dùng."
msgstr "Control your computer remotely — no open ports, no static IP. Install the app, sign in with the same account, and your machine shows up ready to use."

msgid "Studio AI biến brief và tài sản tham chiếu thành prompt nhiều cảnh, storyboard và gói sản xuất nhất quán."
msgstr "An AI studio that turns briefs and reference assets into multi-scene prompts, storyboards and consistent production packs."

msgid "Ảnh nội bộ (máy nhà)"
msgstr "In-house images (home machine)"

msgid "Tạo ảnh bằng model chạy trên máy của LTT Studios. Sinh ảnh từ mô tả, sửa ảnh theo lệnh, giữ nhân vật nhất quán qua nhiều ảnh."
msgstr "Generate images with models running on LTT Studios machines. Create images from a description, edit images by instruction, and keep a character consistent across images."

msgid "Sinh ảnh nền thumbnail YouTube từ mô tả, bằng model nội bộ. Ảnh KHÔNG có chữ — chữ thêm bằng công cụ chỉnh sửa của bạn."
msgstr "Generate YouTube thumbnail backgrounds from a description, using an in-house model. Images contain NO text — add text with your own editing tool."

msgid "Kiểm tra lại địa chỉ, hoặc mở trang từ menu phía trên. Nếu bạn đến đây từ một liên kết trong hệ thống, gửi mã tra cứu bên dưới cho bộ phận hỗ trợ."
msgstr "Check the address, or open the page from the menu above. If you followed a link inside the platform, send the reference code below to support."

msgid "Đường dẫn có thể đã gõ sai, đã đổi, hoặc nội dung đã bị xoá."
msgstr "The link may be mistyped or changed, or the content may have been deleted."

msgid "Một số trang chỉ mở sau khi đăng nhập. Đăng nhập rồi thử lại, hoặc quay về trang chính."
msgstr "Some pages only open after you sign in. Sign in and try again, or go back to the home page."

msgid "Tình trạng theo năng lực"
msgstr "Status by capability"

msgid "Khi một năng lực được mở, tình trạng của nó sẽ hiện ở đây."
msgstr "When a capability is opened, its status will appear here."

msgid "Hồ sơ môi trường"
msgstr "Environment profile"

msgid "Thư mục dữ liệu"
msgstr "Data directory"

msgid "Thư mục nhật ký"
msgstr "Log directory"

msgid "Lỗi chặn"
msgstr "Blocker"

msgid "Cảnh báo"
msgstr "Warning"

msgid "Đạt"
msgstr "Passed"

msgid "Không đọc được số liệu"
msgstr "Could not read metrics"

msgid "Chưa có máy nào ghép"
msgstr "No paired devices yet"

msgid "Có máy đang bật"
msgstr "Devices online"

msgid "Không máy nào đang bật"
msgstr "No devices online"

msgid "Đang xác nhận thanh toán"
msgstr "Confirming payment"

msgid "Cổng thanh toán đã báo nhận tiền — đang chờ ngân hàng xác nhận để cộng credit. Bạn không cần chuyển lại."
msgstr "The payment gateway reported your payment — waiting for the bank to confirm before adding credit. You do not need to pay again."

msgid "Đơn đã quá thời hạn thanh toán nên không còn nhận chuyển khoản."
msgstr "This order passed its payment deadline and no longer accepts transfers."

msgid "Đơn đã bị hủy nên không thể thanh toán tiếp."
msgstr "This order was cancelled and can no longer be paid."

msgid "Cổng thanh toán báo giao dịch không thành công; credit chưa được cộng."
msgstr "The payment gateway reported the transaction failed; no credit has been added."

msgid "Hết hạn lúc"
msgstr "Expired at"

msgid "Đơn đã hết hạn thanh toán."
msgstr "This order has expired."

msgid "Mã thanh toán của đơn này không còn dùng được. Tạo đơn mới để nhận mã mới."
msgstr "This order's payment code can no longer be used. Create a new order to get a new code."

msgid "Đơn đã bị hủy."
msgstr "This order was cancelled."

msgid "Đơn hủy không cộng credit. Muốn nạp tiếp, hãy tạo đơn mới."
msgstr "Cancelled orders do not add credit. To top up, create a new order."

msgid "Thanh toán không thành công."
msgstr "Payment failed."

msgid "Cổng thanh toán từ chối giao dịch. Kiểm tra số dư hoặc hạn mức tài khoản ngân hàng rồi thử lại với đơn mới."
msgstr "The payment gateway declined the transaction. Check your bank balance or limit, then try again with a new order."

msgid "Thử lại với đơn mới"
msgstr "Try again with a new order"

msgid "Bộ lọc"
msgstr "Filters"

msgid "%(n)s đang áp dụng"
msgstr "%(n)s active"

msgid "Danh sách việc"
msgstr "Job list"

msgid "Tải tệp ở phần “Tệp kết quả” bên dưới."
msgstr "Download files in “Result files” below."

msgid "Mở lại %(app)s để xem và dùng kết quả."
msgstr "Open %(app)s again to view and use the result."

msgid "Lý do:"
msgstr "Reason:"

msgid "Việc đã hủy."
msgstr "Job cancelled."

msgid "Việc dừng theo yêu cầu hủy và không được xử lý tiếp; credit giữ cho việc này được hoàn lại. Bấm “Thử lại” nếu muốn chạy lại."
msgstr "The job stopped at your cancellation request and will not be processed further; credit held for it is refunded. Press “Retry” to run it again."

msgid "Đã tạo việc"
msgstr "Job created"

msgid "Đang chờ đến lượt xử lý"
msgstr "Waiting for its turn"

msgid "Dừng do lỗi"
msgstr "Stopped with an error"

msgid "Thuộc dự án"
msgstr "Project"

msgid "Mỗi tích hợp một dự án thì báo cáo chi tiêu tách được."
msgstr "One project per integration keeps spending reports separate."

msgid "Các lời gọi ở đây chưa gắn công cụ hoặc khóa nào, nên cột đó được ẩn."
msgstr "These calls are not tied to a tool or key yet, so that column is hidden."

msgid "Nguồn máy"
msgstr "Machine power"

msgid "Ba việc dưới đây không hoàn tác được. Hãy gõ đúng tên máy để xác nhận — bước này có chủ ý, để không ai lỡ tay bấm nhầm."
msgstr "The three actions below cannot be undone. Type the machine name exactly to confirm — this step is deliberate, so nobody clicks by accident."

msgid "Đang chuẩn bị — sẽ có sớm"
msgstr "In preparation — coming soon"

msgid "Mở bằng Safari trên iPhone/iPad để cài."
msgstr "Open in Safari on iPhone/iPad to install."

msgid "Cài qua SideStore hoặc Sideloadly (bản chưa lên App Store)."
msgstr "Install with SideStore or Sideloadly (not on the App Store yet)."

msgid "Sẵn sàng để tải"
msgstr "Ready to download"

msgid "Điều khiển máy tính từ xa — an toàn, do LTT vận hành."
msgstr "Remote computer control — secure, operated by LTT."

msgid "Mở App Store"
msgstr "Open App Store"

msgid "Cài đặt & an toàn"
msgstr "Installation & safety"

msgid "Sau khi tải, đối chiếu SHA-256 (ghi ở mỗi nền tảng) với file bạn tải — khớp mới chạy."
msgstr "After downloading, compare the SHA-256 (listed for each platform) with your file — run it only if they match."

msgid "Windows có thể hiện cảnh báo SmartScreen (bản chưa ký): bấm More info → Run anyway, chỉ khi hash đúng."
msgstr "Windows may show a SmartScreen warning (unsigned build): click More info → Run anyway, only if the hash matches."

msgid "Mở app, đăng nhập tài khoản LTT. Máy sẽ gắn vào tài khoản của bạn."
msgstr "Open the app and sign in with your LTT account. The machine is linked to your account."

msgid "Muốn điều khiển máy khi vắng người: bấm Install trong app (nâng quyền một lần)."
msgstr "To control the machine when nobody is there: click Install in the app (one-time elevation)."

msgid "LTT Nexus dựa trên RustDesk (AGPL-3.0); mã nguồn bản sửa được công bố công khai."
msgstr "LTT Nexus is based on RustDesk (AGPL-3.0); the modified source code is published."

msgid "Đã trả phí"
msgstr "Paid"

msgid "Chưa trả phí"
msgstr "Unpaid"

msgid "Thấy lần cuối"
msgstr "Last seen"

msgid "Chưa từng kết nối"
msgstr "Never connected"

msgid "Lưu tên"
msgstr "Save name"

msgid "Nhật ký truy cập"
msgstr "Access log"

msgid "Ai đã điều khiển máy của bạn, lúc nào. Bản ghi này không sửa được và không mất khi thu hồi máy."
msgstr "Who controlled your machines, and when. This record cannot be edited and is kept when a machine is revoked."

msgid "Chưa có phiên điều khiển nào."
msgstr "No control sessions yet."

msgid "Khi có ai điều khiển một máy của bạn, lúc bắt đầu, địa chỉ IP và thời lượng sẽ ghi ở đây."
msgstr "When someone controls one of your machines, the start time, IP address and duration are recorded here."

msgid "Từ IP"
msgstr "From IP"

msgid "Kéo dài"
msgstr "Duration"

msgid "(máy đã xoá)"
msgstr "(machine deleted)"

msgid "Đang mở"
msgstr "Open"

msgid "Model AI"
msgstr "AI model"

msgid "Video Seedance của tôi"
msgstr "My Seedance videos"

msgid "Tạo thumbnail YouTube"
msgstr "Create YouTube thumbnails"

msgid "Lưu làm bộ nhận diện thương hiệu mặc định của tôi"
msgstr "Save as my default brand kit"

msgid "Đang lấy mẫu phong cách, bộ nhận diện thương hiệu và lịch sử của tài khoản."
msgstr "Loading style presets, brand kit and account history."

msgid "Danh sách mốc ngắt"
msgstr "Pause markers"

msgid "Mỗi mốc là một chỗ cần ngắt trong bài, gồm ba phần:"
msgstr "Each marker is one place to pause in the recording, with three parts:"

msgid "số thứ tự của mốc (1, 2, 3…)"
msgstr "the marker number (1, 2, 3…)"

msgid "câu ngay TRƯỚC chỗ cần ngắt, chép đúng như trong bản thu"
msgstr "the sentence right BEFORE the pause, exactly as spoken in the recording"

msgid "độ dài khoảng lặng, tính bằng mili-giây (1000 = 1 giây)"
msgstr "pause length in milliseconds (1000 = 1 second)"

msgid "Chèn ví dụ mẫu"
msgstr "Insert example"

msgid "Bấm “Chèn ví dụ mẫu” rồi sửa câu và thời lượng cho khớp bài của bạn."
msgstr "Click “Insert example”, then edit the sentences and durations to match your recording."

msgid "Xin chào các bạn."
msgstr "Hello everyone."

msgid "Hôm nay chúng ta nói về Hà Nội."
msgstr "Today we talk about Hanoi."

msgid "Thay nội dung đang có bằng ví dụ mẫu?"
msgstr "Replace the current content with the example?"

msgid "Đúng định dạng:"
msgstr "Valid format:"

msgid "mốc."
msgstr "markers."

msgid "Chưa đúng định dạng — mỗi mốc cần đủ id, anchor_text và pause_ms. Bấm “Chèn ví dụ mẫu” để xem cách viết."
msgstr "Invalid format — each marker needs id, anchor_text and pause_ms. Click “Insert example” to see how."

msgid "Bảng dữ liệu"
msgstr "Data tables"

msgid "quản trị · bảng dữ liệu"
msgstr "admin · data tables"

msgid "Đường dẫn"
msgstr "Breadcrumb"

msgid "Chọn công cụ…"
msgstr "Choose a tool…"

msgid "Chưa có công cụ nào đang bật"
msgstr "No tools are enabled yet"

msgid "Thực hiện yêu cầu đầu tiên"
msgstr "Make your first request"

msgid "Bộ sưu tập Postman"
msgstr "Postman collection"

msgid "Tệp môi trường Postman"
msgstr "Postman environment file"

msgid "Không bắt buộc phải tạo trước: khóa đầu tiên của bạn sẽ tự sinh một project tên “Mặc định”. Tạo project riêng khi bạn có từ hai tích hợp trở lên."
msgstr "You don't have to create one first: your first key creates a project named “Default”. Create separate projects once you have two or more integrations."

msgid "Đơn này chưa thanh toán tự động được — quản trị sẽ hướng dẫn chuyển khoản và cộng credit thủ công."
msgstr "This order cannot be paid automatically yet — an administrator will send transfer instructions and add credit manually."

msgid "Cách thanh toán"
msgstr "How to pay"

msgid "Bấm “Mở PayOS / VietQR” để mở trang thanh toán."
msgstr "Press “Open PayOS / VietQR” to open the payment page."

msgid "Quét mã bằng ứng dụng ngân hàng, giữ nguyên số tiền và nội dung chuyển khoản."
msgstr "Scan the code with your banking app and keep the amount and transfer note unchanged."

msgid "Để trang này mở — trạng thái tự cập nhật khi ngân hàng báo về."
msgstr "Keep this page open — the status updates by itself when the bank confirms."

msgid "Thanh toán thủ công"
msgstr "Manual payment"

msgid "Liên hệ quản trị và gửi mã đơn %(ma)s."
msgstr "Contact an administrator and send order code %(ma)s."

msgid "Chuyển khoản theo hướng dẫn quản trị gửi, đúng số tiền của đơn."
msgstr "Transfer as instructed by the administrator, for the exact order amount."

msgid "Quản trị xác nhận rồi cộng credit; trang này tự cập nhật."
msgstr "The administrator confirms and adds credit; this page updates by itself."

msgid "Liên hệ quản trị"
msgstr "Contact an administrator"

msgid "Cần hỗ trợ?"
msgstr "Need help?"

msgid "Gửi quản trị mã đơn %(ma)s kèm mã giao dịch ngân hàng (nếu có) để được đối soát nhanh."
msgstr "Send an administrator order code %(ma)s with your bank transaction code (if any) for a quick reconciliation."

