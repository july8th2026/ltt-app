#: server/templates/vps_chi_tiet.html
msgid "Máy đang bị cách ly mạng"
msgstr "Machine network-quarantined"

msgid ""
"Máy đang bị giảm tốc vì đã vượt hạn mức. Không bị tính thêm tiền — tốc độ trở lại bình thường khi"
" sang chu kỳ mới."
msgstr ""
"The machine is throttled because it went over its allowance. Nothing extra is charged — full "
"speed returns with the next cycle."

msgid "Máy đang bị treo do hết hạn thanh toán. Nạp credit và gia hạn để dùng lại."
msgstr "The machine is suspended because payment lapsed. Top up credit and renew to use it again."

msgid "Máy đang bị tạm dừng"
msgstr "This machine is suspended"

msgid "Máy đang được tạo. Tải lại trang sau vài phút."
msgstr "The machine is being created. Reload the page in a few minutes."

msgid "Máy đã bị xoá"
msgstr "Machine deleted"

msgid "Máy đã bị xoá. Không khôi phục được."
