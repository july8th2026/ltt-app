#: apps/prompt_ai_ommi/services/composer.py:79 server/templates/dev_tool_detail.html:46
msgid "Mặc định"
msgstr "Default"

msgid ""
"Mặc định ứng dụng chỉ mở tab Code. Tab đó không nói thẳng với API — nó mở một phiên tác tử chạy "
"trên máy bạn, và phiên đó cần sẵn công cụ dòng lệnh trên máy. Không có thì ứng dụng không gửi "
"request nào cả."
msgstr ""
"By default the app opens only the Code tab. That tab does not talk to the API directly — it opens"
" an agent session running on your machine, and that session needs the command-line tool "
"installed. Without it the app sends no request at all."

#: apps/vps/dieu_khoan.py
