#, python-format
msgid ""
"Ảnh chụp hằng tuần, giữ %(n)s bản, trên cùng kho lưu trữ với máy. Nó KHÔNG thay thế bản sao lưu "
"của riêng bạn."
msgstr ""
"A weekly snapshot, %(n)s kept, on the same storage as the machine. It does NOT replace a backup "
"of your own."

msgid ""
"Ảnh chụp hằng tuần, giữ 1 bản. Ảnh chụp nằm trên cùng kho lưu trữ với máy — nó cứu bạn khỏi xoá "
"nhầm hoặc một bản vá hỏng, nhưng KHÔNG thay thế bản sao lưu của riêng bạn."
msgstr ""
"Weekly snapshot, one kept. The snapshot sits on the same storage as the machine — it saves you "
"from a mistaken deletion or a bad patch, but it is NOT a substitute for your own backup."

#: apps/vps/nhan.py
msgid "Ảnh chụp này không dùng được để khôi phục. Hãy chọn một ảnh khác."
msgstr "This snapshot cannot be used to restore. Please pick another one."

#: apps/vps/dieu_khoan.py
msgid ""
"Ảnh chụp nằm <strong>trên cùng kho lưu trữ</strong> với máy của bạn. Kho hỏng thì mất cả hai. Nó "
"<strong>không thay thế bản sao lưu của riêng bạn</strong>."
msgstr ""
"Snapshots live <strong>on the same storage</strong> as your machine. If that storage fails, both "
"are lost. A snapshot <strong>does not replace your own backup</strong>."

#: apps/vps/dieu_khoan.py
msgid ""
"Ảnh chụp được lấy khi máy đang chạy, giống như rút điện rồi bật lại. Nó giữ những gì <strong>đã "
"ghi xuống đĩa</strong>, không phải mọi thứ tại đúng thời điểm chụp. Dữ liệu vừa ghi trong vài "
"giây trước đó có thể không có trong ảnh."
msgstr ""
"Snapshots are taken while the machine runs — like pulling the power and booting again. They "
"capture what has <strong>reached the disk</strong>, not everything as of that exact instant. Data"
" written seconds earlier may not be in the snapshot."

#: apps/vps/dieu_khoan.py
msgid "Ảnh chụp — không phải bản sao lưu"
msgstr "Snapshots — not backups"

