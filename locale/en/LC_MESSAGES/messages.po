#: server/templates/_cam_chon.html:247
msgid ""
"Sau khi một stream lỗi, Claude Code có thể thử lại bằng stream=false. "
"CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1 giữ lần thử lại ở đường streaming, đúng với gateway "
"có SSE heartbeat. Ngày 15/09, một phiên 99.6k token bị 400 vì lần fallback non-streaming mang "
"98.678 token đầu vào vào cửa JSON 90 giây; biến này xử lý đúng cơ chế đó."
msgstr ""
