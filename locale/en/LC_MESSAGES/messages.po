msgid "Dùng thế nào"
msgstr "How it works"

msgid "<b>Cài trên máy muốn điều khiển từ xa</b> — tải bản đúng hệ điều hành ở trên rồi chạy file cài."
msgstr "<b>Install it on the machine you want to reach</b> — pick the build for its operating system above and run the installer."

msgid "<b>Đăng nhập tài khoản LTT ngay trong ứng dụng</b> — dùng đúng email và mật khẩu bạn đăng nhập trang này."
msgstr "<b>Sign in to your LTT account inside the app</b> — the same email and password you use on this site."

msgid "<b>Cài trên máy (hoặc điện thoại) bạn ngồi</b> và đăng nhập cùng tài khoản đó."
msgstr "<b>Install it on the machine or phone you are sitting at</b> and sign in with that same account."

