msgstr "Choose the language of your script. The voice must match it; a mismatched request is refused before any credit is charged."

#: apps/ltt_voice
msgid "Hãy chọn ngôn ngữ của clip giọng: Tiếng Việt hoặc Tiếng Anh."
msgstr "Please choose the language of the voice clip: Vietnamese or English."

#: apps/ltt_voice
msgid "Clip nguồn của giọng này đo được là {lan}. Không đổi được sang ngôn ngữ khác."
msgstr "This voice's source clip measured as {lan}. It cannot be switched to another language."

#: apps/ltt_voice
msgid "Giọng này đã bị thu hồi, không sửa được nữa."
msgstr "This voice has been revoked and can no longer be edited."

#: apps/ltt_voice
msgid "Bạn đã có một giọng tên này. Hãy đặt tên khác."
msgstr "You already have a voice with this name. Please choose another one."

#: apps/ltt_voice
msgid "Chọn ngôn ngữ của clip"
msgstr "Choose the language of the clip"

#: apps/ltt_voice
msgid "Xác nhận ngôn ngữ của giọng này"
msgstr "Confirm this voice's language"

#: apps/ltt_voice
msgid "Đo từ clip"
msgstr "Measured from the clip"

#: apps/ltt_voice
msgid "Xoá giọng"
msgstr "Delete voice"

#: apps/ltt_voice
msgid "Bạn có thể tắt một giọng bất cứ lúc nào để ngừng dùng nó, hoặc xoá vĩnh viễn để gỡ hẳn clip gốc và dữ liệu giọng khỏi máy chủ. Xoá vĩnh viễn không khôi phục được; lịch sử lượt đọc và bút toán credit vẫn được giữ để đối chiếu."
msgstr "You can turn off a voice at any time to stop using it, or delete it permanently to remove the source clip and voice data from the server. Permanent deletion cannot be undone; usage history and credit entries are still kept for reconciliation."

#: apps/ltt_voice
msgid "Giọng này đã bị thu hồi và không dùng được nữa."
msgstr "This voice has been deleted and can no longer be used."

#: apps/ltt_voice
msgid "Ghi danh giọng này không thành công. Hãy tạo lại giọng với một clip khác."
msgstr "Enrolling this voice failed. Please create it again with a different clip."

#: apps/ltt_voice
msgid "Giọng này đã bị thu hồi."
msgstr "This voice has already been deleted."

#: apps/ltt_voice
msgid "Giọng đang ở trạng thái không tắt được."
msgstr "This voice is in a state where it cannot be turned off."

#: apps/ltt_voice
msgid "Giọng đang ở trạng thái không thu hồi được."
msgstr "This voice is in a state where it cannot be deleted."

#: apps/ltt_voice
msgid "Xoá vĩnh viễn thì clip gốc và dữ liệu giọng bị xoá khỏi máy chủ, không khôi phục được. Lịch sử lượt đọc và bút toán credit vẫn giữ để đối chiếu."
msgstr "Permanent deletion removes the source clip and voice data from the server, and cannot be undone. Usage history and credit entries are still kept for reconciliation."

#: apps/ltt_voice
msgid "Xoá vĩnh viễn giọng này? Clip gốc và dữ liệu giọng sẽ bị xoá khỏi máy chủ và không khôi phục được."
msgstr "Delete this voice permanently? The source clip and voice data will be removed from the server and cannot be recovered."

#: apps/ltt_voice
msgid "Không thu hồi được giọng này."
msgstr "Could not delete this voice."

#: apps/ltt_voice
msgid "Bạn có thể tắt một giọng bất cứ lúc nào để ngừng dùng nó, hoặc xoá vĩnh viễn để xoá clip gốc và dữ liệu giọng (biểu diễn) khỏi máy chủ — không khôi phục được. Một bản nghe thử của phiên bản engine cũ có thể còn sót tới lượt dọn kế tiếp. Lịch sử lượt đọc và bút toán credit vẫn được giữ để đối chiếu."
msgstr "You can turn off a voice at any time to stop using it, or delete it permanently to remove the source clip and voice data (embedding) from the server — this cannot be undone. A preview from an older engine version may remain until the next cleanup. Usage history and credit entries are still kept for reconciliation."

#: apps/ltt_voice
msgid "Clip này không dùng được để ghi danh. Hãy tạo lại giọng với một clip khác."
msgstr "This clip cannot be used to enroll a voice. Please create the voice again with a different clip."

#: apps/ltt_voice
msgid "Giọng này đã được đánh dấu lỗi ở một lượt ghi danh khác."
msgstr "This voice was already marked as failed by another enrollment attempt."

#: apps/ltt_voice
msgid "Giọng này đã bị tắt trong lúc ghi danh."
msgstr "This voice was turned off while it was being enrolled."

#: apps/ltt_voice
msgid "Giọng này không còn ở trạng thái ghi danh nữa."
msgstr "This voice is no longer in the enrolling state."

#: apps/ltt_voice
msgid "Chỉ thu hồi được tối đa {n} giọng trong một lượt."
msgstr "You can delete at most {n} voices in one request."

#: apps/ltt_voice
msgid "Bạn có thể tắt một giọng bất cứ lúc nào để ngừng dùng nó, hoặc xoá vĩnh viễn để xoá clip gốc và dữ liệu giọng (biểu diễn) khỏi máy chủ — không khôi phục được. Một bản nghe thử của phiên bản engine cũ có thể vẫn còn sót lại trên máy chủ. Lịch sử lượt đọc và bút toán credit vẫn được giữ để đối chiếu."
msgstr "You can turn off a voice at any time to stop using it, or delete it permanently to remove the source clip and voice data (embedding) from the server — this cannot be undone. A preview from an older engine version may still remain on the server. Usage history and credit entries are still kept for reconciliation."

#: apps/ltt_voice
msgid "Đã hết hạn"
msgstr "Expired"

#: apps/ltt_voice
msgid "Nội dung đã hết hạn sau {n} ngày lưu trữ và được dọn. Bản ghi vẫn được giữ để đối chiếu."
msgstr "Content expired after {n} days of retention and was cleaned up. The record is kept for reconciliation."

#: apps/ltt_voice
msgid "Đã tải"
msgstr "Downloaded"

#: apps/ltt_voice
msgid "Bạn đã xoá lượt này. Tệp tiếng đã được xoá; bản ghi vẫn được giữ để đối chiếu."
msgstr "You deleted this item. The audio file has been removed; the record is kept for reconciliation."

#: apps/ltt_voice
msgid "Xoá lượt này — tệp tiếng sẽ bị xoá, không lấy lại được."
msgstr "Delete this item — the audio file will be removed and cannot be recovered."

#: apps/ltt_voice
msgid "Xoá lượt này? Tệp tiếng sẽ bị xoá và không lấy lại được. Bản ghi vẫn được giữ để đối chiếu."
msgstr "Delete this item? The audio file will be removed and cannot be recovered. The record is kept for reconciliation."

#: apps/ltt_voice
msgid "Lượt đang xử lý chưa xoá được. Chờ nó xong hoặc huỷ trước."
msgstr "This item is still processing and cannot be deleted yet. Wait for it to finish or cancel it first."

#: apps/ltt_voice
msgid "Không xoá được lượt này. Thử lại sau."
msgstr "Could not delete this item. Try again later."

#: apps/ltt_voice
msgid "Dấu người dùng đặt lên một lượt lịch sử: đã tải về chưa, đã xoá chưa. Không chứa văn bản hay tệp — chỉ hai cột thời điểm. Xoá một lượt dọn TỆP theo vòng đời của job; dòng này chỉ ghi rằng khách đã xoá."
msgstr "A user-set marker on a history item: whether it has been downloaded, whether it has been deleted. Holds no text or files — just two timestamps. Deleting an item removes the FILE per the job's lifecycle; this row only records that the customer deleted it."

#: apps/ltt_voice
msgid "Khối {so} trong dự án “{ten}” sẽ mất tiếng và cần tạo lại."
msgstr "Block {so} in project “{ten}” will lose its audio and need to be regenerated."

#: apps/ltt_voice
msgid "Không kiểm được các dự án đang dùng tệp này. Việc xoá vẫn tiếp tục nếu bạn xác nhận."
msgstr "Could not check which projects use this file. Deleting will still go ahead if you confirm."

#: apps/ltt_voice
msgid "Cần tạo lại"
msgstr "Needs regenerating"

#: apps/ltt_voice
msgid "Khối này đang được đọc — đợi lượt trước xong đã."
msgstr "This block is already being read — wait for it to finish first."

#: apps/ltt_voice
msgid "Văn bản đã đổi — cần tạo lại."
msgstr "The text changed — needs regenerating."

#: apps/ltt_voice
msgid "Không phát được bản nghe thử"
msgstr "Could not play the preview"

#: apps/ltt_voice
msgid "Kho chung"
msgstr "Shared library"

#: apps/ltt_voice
msgid "Chưa rõ ngôn ngữ"
msgstr "Language unknown"

#: apps/ltt_voice
msgid "Lọc thêm"
msgstr "More filters"

#: apps/ltt_voice
msgid "Đang hiện {n} giọng {lan}"
msgstr "Showing {n} {lan} voices"

#: apps/ltt_voice
msgid "{n} giọng chưa khai ngôn ngữ, tạm ẩn"
msgstr "{n} voices with no declared language, hidden for now"

#: apps/ltt_voice
msgid "Đã bỏ chọn “{ten}” vì giọng đó thuộc ngôn ngữ khác. Hãy chọn một giọng trong danh sách."
msgstr "Deselected “{ten}” because that voice is a different language. Pick a voice from the list."

#: apps/ltt_voice
msgid "Hãy nhập nội dung cần đọc."
msgstr "Enter the text you want read aloud."

#: apps/ltt_voice
msgid "Văn bản đang dài quá giới hạn một lượt đọc."
msgstr "The text is longer than the limit for a single read."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ có giá trị không đọc được."
msgstr "The text overlay has a value that cannot be read."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ có giá trị ngoài khoảng cho phép."
msgstr "The text overlay has a value outside the allowed range."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ không đọc được."
msgstr "The text overlay cannot be read."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ không được để trống."
msgstr "The text overlay cannot be empty."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ dài quá {n} ký tự."
msgstr "The text overlay is longer than {n} characters."

#: apps/auto_scan_video/lop_phu.py
msgid "Lớp phủ chữ chỉ nhận MỘT dòng, không có ký tự điều khiển. Muốn phụ đề theo lời thoại thì dùng công cụ phụ đề, không dùng lớp phủ."
msgstr "A text overlay takes ONE line with no control characters. For subtitles that follow the dialogue, use the subtitle tool, not an overlay."

#: apps/auto_scan_video/lop_phu.py
msgid "Màu chữ không hợp lệ."
msgstr "That text colour is not valid."

#: apps/auto_scan_video/lop_phu.py
msgid "Khoảng thời gian của lớp phủ chữ không đọc được."
msgstr "The time range of the text overlay cannot be read."

#: apps/auto_scan_video/lop_phu.py
msgid "Khoảng thời gian của lớp phủ chữ không hợp lệ."
msgstr "The time range of the text overlay is not valid."

#: apps/auto_scan_video/lop_phu.py
msgid "Danh sách lớp phủ chữ không đọc được."
msgstr "The list of text overlays cannot be read."

#: apps/auto_scan_video/lop_phu.py
msgid "Tối đa {n} lớp phủ chữ trong một lần chạy."
msgstr "At most {n} text overlays per run."

#: apps/auto_scan_video/lop_phu.py
msgid "Máy chủ không có phông chữ nào để vẽ lớp phủ. Đặt {b} trỏ tới một tệp .ttf."
msgstr "This server has no font available to draw the overlay. Point {b} at a .ttf file."

#: apps/auto_scan_video/lop_phu.py
msgid "Không biết chiều cao khung hình để vẽ viền chữ."
msgstr "The frame height needed to size the text outline is unknown."

#: apps/auto_scan_video/che_do_render.py
msgid "Không dựng được lớp phủ chữ cho lần chạy này."
msgstr "The text overlays could not be built for this run."

#: apps/auto_scan_video/che_do_render.py
msgid "Một lớp phủ chữ được đặt giờ nằm trọn trong đoạn đã bị cắt bỏ, nên nó sẽ không bao giờ hiện ra. Hãy sửa giờ hoặc xoá lớp đó."
msgstr "A timed text overlay falls entirely inside a stretch that was cut out, so it would never appear. Change its timing or remove it."

#: apps/auto_scan_video/ban_dung.py
msgid "Lớp phủ chữ chỉ dùng được với kiểu xử lý có biên tập lại hình."
msgstr "Text overlays only work with the processing mode that re-edits the picture."

#: apps/auto_scan_video/ban_dung.py
msgid "Bản dựng có lớp phủ chữ nhưng không khai chiều cao khung hình."
msgstr "The manifest has text overlays but does not declare the frame height."

#: apps/auto_scan_video/ket_xuat.py
msgid "Số tệp chữ ({co}) không khớp số lớp phủ trong bản dựng ({can})."
msgstr "The number of text files ({co}) does not match the overlays in the manifest ({can})."

#: apps/auto_scan_video/routes.py
msgid "Kiểu “Giữ nguyên hình ảnh” sao chép nguyên vẹn từng điểm ảnh, nên không thể vẽ chữ lên hình. Chọn “Rút gọn có biên tập” nếu bạn muốn thêm lớp phủ chữ."
msgstr "“Keep the picture” copies every pixel untouched, so no text can be drawn onto it. Choose “Shorten with editing” if you want a text overlay."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Lớp phủ chữ"
msgstr "Text overlay"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Thêm một dòng chữ của bạn lên video — tên kênh, lời kêu gọi. Tối đa %(n)s dòng."
msgstr "Add a line of your own text to the video — a channel name, a call to action. Up to %(n)s lines."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Công cụ lớp phủ chữ"
msgstr "Text overlay tools"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Thêm dòng chữ"
msgstr "Add a line"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Chưa có dòng chữ nào."
msgstr "No lines yet."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "%(so)s dòng chữ."
msgstr "%(so)s lines of text."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Ví dụ: Đăng ký kênh nhé!"
msgstr "For example: Subscribe to the channel!"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Ngang (%)"
msgstr "Across (%)"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Dọc (%)"
msgstr "Down (%)"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Cỡ chữ (%)"
msgstr "Text size (%)"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Màu"
msgstr "Colour"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Trắng"
msgstr "White"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Đen"
msgstr "Black"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Vàng"
msgstr "Yellow"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Viền"
msgstr "Outline"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Xoá dòng này"
msgstr "Remove this line"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Tối đa %(n)s dòng chữ."
msgstr "At most %(n)s lines of text."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Dòng chữ không được để trống."
msgstr "A line of text cannot be empty."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Lớp phủ chữ chỉ nhận MỘT dòng."
msgstr "A text overlay takes ONE line."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Thử tải lên lại"
msgstr "Try uploading again"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Đang thử lại lần %(lan)s…"
msgstr "Retrying, attempt %(lan)s…"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Tải lên bị gián đoạn. Video này lớn hơn %(mb)s MB nên không gửi kèm biểu mẫu được — hãy bấm “Thử tải lên lại”."
msgstr "The upload was interrupted. This video is larger than %(mb)s MB, so it cannot be sent with the form — please press “Try uploading again”."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Tải lên trực tiếp không chạy được. Đang gửi theo đường thường…"
msgstr "Direct upload is unavailable. Sending the usual way…"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "vượt quá %(mb)s MB — định dạng này chỉ gửi được bản nhỏ. Hãy đổi sang MP4 hoặc MOV."
msgstr "over %(mb)s MB — this format can only be sent in small sizes. Please convert it to MP4 or MOV."

#: apps/auto_scan_video/logo.py
msgid "Logo có giá trị không đọc được."
msgstr "The logo has a value that cannot be read."

#: apps/auto_scan_video/logo.py
msgid "Logo có giá trị ngoài khoảng cho phép."
msgstr "The logo has a value outside the allowed range."

#: apps/auto_scan_video/logo.py
msgid "Logo không đọc được."
msgstr "The logo cannot be read."

#: apps/auto_scan_video/logo.py
msgid "Logo trỏ tới một tệp không hợp lệ."
msgstr "The logo points at an invalid file."

#: apps/auto_scan_video/logo.py
msgid "Khoảng thời gian của logo không đọc được."
msgstr "The logo's time range cannot be read."

#: apps/auto_scan_video/logo.py
msgid "Khoảng thời gian của logo không hợp lệ."
msgstr "The logo's time range is not valid."

#: apps/auto_scan_video/logo.py
msgid "Danh sách logo không đọc được."
msgstr "The list of logos cannot be read."

#: apps/auto_scan_video/logo.py
msgid "Tối đa {n} logo trong một lần chạy."
msgstr "At most {n} logos per run."

#: apps/auto_scan_video/logo.py
msgid "Không biết chiều rộng khung hình để đặt logo."
msgstr "The frame width needed to place the logo is unknown."

#: apps/auto_scan_video/ban_dung.py
msgid "Logo chỉ dùng được với kiểu xử lý có biên tập lại hình."
msgstr "Logos only work with the processing mode that re-edits the picture."

#: apps/auto_scan_video/ban_dung.py
msgid "Bản dựng có logo nhưng không khai chiều rộng khung hình."
msgstr "The manifest has logos but does not declare the frame width."

#: apps/auto_scan_video/ban_dung.py
msgid "Bản dựng có logo thiếu khoá lưu trữ."
msgstr "A logo in the manifest has no storage key."

#: apps/auto_scan_video/che_do_render.py
msgid "Không dựng được logo cho lần chạy này."
msgstr "The logos could not be built for this run."

#: apps/auto_scan_video/che_do_render.py
msgid "Một logo được đặt giờ nằm trọn trong đoạn đã bị cắt bỏ, nên nó sẽ không bao giờ hiện ra. Hãy sửa giờ hoặc xoá logo đó."
msgstr "A timed logo falls entirely inside a stretch that was cut out, so it would never appear. Change its timing or remove it."

#: apps/auto_scan_video/ket_xuat.py
msgid "Số tệp logo ({co}) không khớp số logo trong bản dựng ({can})."
msgstr "The number of logo files ({co}) does not match the logos in the manifest ({can})."

#: apps/auto_scan_video/ket_xuat.py
msgid "Bản dựng khai preset giữ hình nhưng có logo."
msgstr "The manifest declares the picture-preserving preset but carries logos."

#: apps/auto_scan_video/routes.py
msgid "Kiểu “Giữ nguyên hình ảnh” sao chép nguyên vẹn từng điểm ảnh, nên không thể dán logo lên hình. Chọn “Rút gọn có biên tập” nếu bạn muốn thêm logo."
msgstr "“Keep the picture” copies every pixel untouched, so no logo can be pasted onto it. Choose “Shorten with editing” if you want a logo."

#: apps/auto_scan_video/routes.py
msgid "Số ảnh logo ({co}) không khớp số logo đã đặt ({can})."
msgstr "The number of logo images ({co}) does not match the logos configured ({can})."

#: apps/auto_scan_video/routes.py
msgid "Ảnh logo vượt quá {mb} MB."
msgstr "The logo image is larger than {mb} MB."

#: apps/auto_scan_video/routes.py
msgid "Ảnh logo rỗng."
msgstr "The logo image is empty."

#: apps/auto_scan_video/templates/asv_trang_chinh.html
msgid "Logo"
msgstr "Logo"

#: apps/auto_scan_video/templates/asv_trang_chinh.html
