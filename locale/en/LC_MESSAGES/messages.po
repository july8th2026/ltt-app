msgid "Máy chủ ảo Windows · Hiệu lực %(ngay)s"
msgstr "Windows virtual servers · Effective %(ngay)s"

msgid "Máy chủ ảo Windows, trả bằng credit"
msgstr "Windows virtual machines, paid with credit"

#: server/templates/nexus_trang_chinh.html:17
msgid "Máy của bạn"
msgstr "Your machines"

msgid ""
"Máy của bạn là một máy trống đã gắn sẵn đĩa cài Windows. Bạn tự chạy trình cài đặt và tự đặt tài "
"khoản của mình — chúng tôi không biết mật khẩu của bạn và không đặt lại được nó."
msgstr ""
"Your machine is an empty one with the Windows install media already attached. You run the "
"installer and create your own account — we never know your password and cannot reset it."

msgid "Máy của bạn, ở bất kỳ đâu"
msgstr "Your machines, wherever you are"

msgid "Máy của bạn, ở bất kỳ đâu bạn đang ngồi"
msgstr "Your machines, from wherever you are sitting"

# Trang "May cua toi" (LTT Nexus)
msgid "Máy của tôi"
msgstr "My devices"

msgid "Máy dừng lại"
msgstr "Machine stopped"

msgid "Máy dựng báo xong nhưng không trả về tệp nào."
msgstr "The video machine reported success but returned no file."

msgid "Máy dựng bật theo nhu cầu — lượt đầu có thể mất thêm vài phút để khởi động."
msgstr "The render machine starts on demand — the first run may take a few extra minutes to boot."

msgid "Máy dựng video chưa sẵn sàng. Credit đã được hoàn, bạn thử lại sau ít phút."
msgstr "The video machine is not ready. Your credits were refunded — please try again in a few minutes."

msgid "Máy dựng video không phản hồi kịp. Credit đã được hoàn, bạn thử lại sau."
msgstr "The render machine did not respond in time. Your credit was refunded; please try again later."

msgid "Máy giao cho bạn là máy trống có đĩa cài — bạn tự đặt tài khoản và mật khẩu của mình."
msgstr "The machine you get is empty with install media attached — you set your own account and password."

msgid "Máy giao cho bạn là máy trống đã gắn sẵn đĩa cài."
msgstr "You get a blank machine with the installation media already attached."

#: apps/vps/dieu_khoan.py
msgid ""
"Máy giao cho bạn là một <strong>máy trống đã gắn sẵn đĩa cài Windows</strong>. Bạn tự chạy trình "
"cài đặt qua console trong trình duyệt và <strong>tự đặt tài khoản và mật khẩu của chính "
"mình</strong>."
msgstr ""
"You receive a <strong>blank machine with Windows installation media attached</strong>. You run "
"the installer yourself through the browser console and <strong>set your own account and "
"password</strong>."

msgid "Máy gặp lỗi. Xem lý do bên dưới, hoặc cài lại máy."
msgstr "This machine hit an error. See the reason below, or reinstall it."

msgid ""
"Máy khách đã thuê: gói, đĩa, hệ điều hành, vmid. Đây là phía đối ứng của hoá đơn — mất nó thì "
"không đối soát được khách trả tiền cho cái gì."
msgstr ""
"The machines a customer rented: plan, disk, operating system, vmid. This is the counterpart of "
"the invoice — lose it and there is no way to reconcile what the customer paid for."

msgid "Máy khởi động lại"
msgstr "Machine restarted"

msgid ""
"Máy nào đã từng được tin, ghép lúc nào, ai thu hồi. Thu hồi ghi `revoked_at` chứ không xoá dòng —"
" xoá là xoá luôn câu trả lời. Chỉ giữ khoá CÔNG KHAI, không bao giờ có khoá riêng."
msgstr ""
"Which machines were ever trusted, when they were paired, and who revoked them. Revoking writes "
"`revoked_at` instead of deleting the row — deleting it would delete the answer too. Only PUBLIC "
"keys are kept; a private key is never held here."

msgid "Máy này chưa có ảnh chụp nào."
msgstr "This machine has no snapshot yet."

msgid "Máy này chưa có ảnh chụp nào. Bản đầu tiên được chụp trong vòng một tuần kể từ khi tạo máy."
msgstr ""
"This machine has no snapshot yet. The first one is taken within a week of the machine being "
"created."

msgid "Máy nên đọc thành"
msgstr "Should be read as"

msgid "Máy nên đọc thành…"
msgstr "Should be read as…"

msgid "Máy phải đang chạy hoặc đã tắt thì mới mở được console."
msgstr "The console only opens when the machine is running or stopped."

msgid ""
"Máy sẽ viết lại mô tả của bạn thành một đoạn dài và chi tiết hơn trước khi dựng. Kết quả sẽ khác "
"với mô tả gốc."
msgstr ""
"The machine will expand your description into a longer, more detailed one before rendering. The "
"result will differ from what you wrote."

msgid "Máy sẽ đọc thành"
msgstr "What will actually be read"

msgid "Máy tính khác, hoặc điện thoại. Đăng nhập cùng tài khoản đó."
msgstr "Another computer, or your phone. Sign in with that same account."

