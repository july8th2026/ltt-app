#: server/templates/vps_base.html
msgid "Khu VPS"
msgstr "VPS area"

#: apps/vps/nav.py
msgid "Console"
msgstr "Console"

msgid "Khóa là thứ duy nhất đứng giữa tài khoản của bạn và người khác. Mỗi tích hợp một khóa, và thu hồi được riêng từng cái."
msgstr "A key is the only thing between your account and everyone else. One key per integration, so you can revoke them one at a time."

msgid "Khóa của bạn"
msgstr "Your keys"

msgid "Chưa có khóa API nào."
msgstr "No API keys yet."

msgid "Khóa là thứ xác thực lời gọi tới /api/v1. Tạo một khóa ở khối bên dưới, chép chuỗi bí mật, rồi gọi thử."
msgstr "A key is what authenticates calls to /api/v1. Create one below, copy the secret, then make a call."

msgid "Tạo khóa đầu tiên"
msgstr "Create your first key"

msgid "Đổi bí mật của khóa này? Chuỗi cũ ngừng hoạt động ngay lập tức."
msgstr "Rotate this key's secret? The old string stops working immediately."

msgid "Thu hồi khóa này? Không đảo ngược được — mọi lời gọi dùng nó sẽ hỏng ngay."
msgstr "Revoke this key? This cannot be undone — every call using it breaks at once."

msgid "Chỉ để bạn nhận ra khóa nào là khóa nào."
msgstr "Only so you can tell your keys apart."

msgid "Mỗi tích hợp một project thì báo cáo chi tiêu tách được."
msgstr "One project per integration keeps spend reporting separable."

msgid "Gọi nhà cung cấp thật, trừ credit thật."
msgstr "Calls the real provider, spends real credit."

msgid "Kết quả mẫu, không gọi nhà cung cấp, không trừ credit."
msgstr "Sample results, no provider call, no credit spent."

msgid "Thu hẹp thêm (tùy chọn)"
msgstr "Narrow it further (optional)"

msgid "Tự hết hạn sau (ngày)"
msgstr "Expire automatically after (days)"

msgid "Để trống = không hết hạn."
msgstr "Blank = never expires."

msgid "Chỉ cho phép gọi từ IP/CIDR"
msgstr "Allow calls only from these IPs/CIDRs"

msgid "Để trống = mọi nơi."
msgstr "Blank = anywhere."

msgid "Chuỗi bí mật sẽ hiện đúng một lần ở màn hình tiếp theo."
msgstr "The secret is shown exactly once, on the next screen."

msgid "Mọi lời gọi tài khoản này thực hiện, kể cả những lời gọi chưa bao giờ chạy — 401, 403, 429 là thứ không có job nào giải thích hộ."
msgstr "Every call this account made, including the ones that never ran — no job explains a 401, a 403 or a 429."

msgid "Request (7 ngày)"
msgstr "Requests (7 days)"

msgid "Không request nào khớp bộ lọc."
msgstr "No request matches this filter."

msgid "Nhật ký chỉ giữ %(days)s ngày gần nhất — một request cũ hơn thế đã bị dọn."
msgstr "Logs keep only the last %(days)s days — anything older has been cleared."

msgid "Chưa có lời gọi API nào."
msgstr "No API calls yet."

msgid "Sau request đầu tiên, mọi lời gọi sẽ hiện ở đây kèm trạng thái, mã lỗi, độ trễ và credit — đủ để tìm ra chuyện gì đã xảy ra."
msgstr "After your first request, every call appears here with its status, error code, latency and credit — enough to work out what happened."

msgid "Thực hiện request đầu tiên"
msgstr "Make your first request"

msgid "Một project gom khóa, nhật ký và chi tiêu của một tích hợp lại — để thu hồi và đọc báo cáo được riêng từng cái."
msgstr "A project groups one integration's keys, logs and spend — so you can revoke and report on each separately."

msgid "Chưa có project nào."
msgstr "No projects yet."

msgid "Không bắt buộc phải tạo trước: khóa đầu tiên của bạn sẽ tự sinh một project tên “Default”. Tạo project riêng khi bạn có từ hai tích hợp trở lên."
msgstr "You do not have to create one first: your first key auto-creates a project called “Default”. Create your own once you have two or more integrations."

msgid "Sang tạo khóa"
msgstr "Go create a key"

msgid "Mười job gần nhất tạo qua API. Đây là bản tóm để liếc nhanh — danh sách đầy đủ nằm ở %(route)s."
msgstr "The ten most recent jobs created through the API. This is a glance — the full list lives at %(route)s."

msgid "Job xuất hiện ở đây sau lời gọi POST /jobs đầu tiên. Lời gọi chỉ đọc (như GET /tools) không tạo job nào — chúng nằm ở mục Nhật ký request."
msgstr "Jobs appear here after your first POST /jobs. Read-only calls (like GET /tools) create no job — those live under Request log."

msgid "Xem nhật ký request"
msgstr "View the request log"

msgid "Chưa có thông báo nào."
msgstr "No notifications yet."

msgid "Cảnh báo xuất hiện ở đây khi số dư xuống thấp, ngân sách chạm ngưỡng, khóa sắp hết hạn hoặc webhook bỏ cuộc. Không có gì ở đây là một tin tốt."
msgstr "Alerts show up here when your balance runs low, a budget hits a threshold, a key nears expiry, or a webhook gives up. An empty list is good news."

msgid "Những gì nền tảng đảm bảo về khóa của bạn, và bạn nên làm gì khi một khóa bị lộ."
msgstr "What the platform guarantees about your keys, and what to do when one leaks."

msgid "Bạn tải được toàn bộ dữ liệu khu API của mình dưới dạng JSON, và xem được từng nơi lưu giữ gì trong bao lâu."
msgstr "You can download all of your API-area data as JSON, and see what each store keeps and for how long."

msgid "Dữ liệu &amp; lưu trữ"
msgstr "Data &amp; retention"

msgid "Sự kiện nền tảng đẩy tới máy chủ của bạn khi job xong hoặc hỏng. Mỗi sự kiện được ký và có id riêng — giao trùng là an toàn nếu bên nhận khử trùng theo id đó."
msgstr "Events the platform pushes to your server when a job finishes or fails. Every event is signed and has its own id — duplicate deliveries are safe if your receiver dedupes on that id."

msgid "Đang chờ giao"
msgstr "Pending"

msgid "Đã giao"
msgstr "Delivered"

msgid "Đang thử lại"
msgstr "Retrying"

msgid "Bỏ cuộc"
msgstr "Gave up"

msgid "Không có webhook thì bạn phải hỏi lại trạng thái job bằng cách gọi vòng lặp. Đăng ký bằng POST /api/v1/webhooks — secret chỉ hiện một lần trong phản hồi đó."
msgstr "Without a webhook you have to poll for job status. Register one with POST /api/v1/webhooks — the secret is shown once, in that response."

msgid "Xem tài liệu webhook"
msgstr "Read the webhook docs"

msgid "Đổi secret? Secret cũ vẫn được ký kèm trong thời gian ân hạn, nên bên nhận không mất sự kiện nào."
msgstr "Rotate the secret? The old one keeps being signed alongside during the grace window, so your receiver misses nothing."

msgid "Tắt điểm nhận này? Bạn sẽ không nhận sự kiện nào nữa cho tới khi bật lại."
msgstr "Disable this endpoint? You will receive no events until it is turned back on."

msgid "Lịch sử giao xuất hiện sau job đầu tiên kết thúc, hoặc ngay bây giờ nếu bạn bấm Gửi thử ở khối trên."
msgstr "Delivery history appears once your first job finishes — or right now, if you press Send test above."

msgid "Credit đã tiêu qua API, và ngân sách bạn tự đặt để không tiêu quá tay. Ngân sách quan sát chi tiêu — nó không bao giờ đổi sổ credit."
msgstr "Credit spent through the API, and the budgets you set to keep it in check. A budget observes spending — it never changes the credit ledger."

msgid "Đang giữ chỗ"
msgstr "On hold"

msgid "credit của job chưa quyết toán"
msgstr "credit for jobs not yet settled"

msgid "Trần của máy chủ"
msgstr "Server cap"

msgid "Không có ngân sách thì chi tiêu chỉ dừng khi hết credit. Đặt một ngân sách mềm để được cảnh báo ở 50%, 80% và 100%."
msgstr "Without a budget, spending only stops when credit runs out. Set a soft budget to be warned at 50%, 80% and 100%."

msgid "Mỗi lời gọi có tính tiền sẽ thành một dòng ở đây, kèm khóa nào gọi và đã tính bao nhiêu."
msgstr "Every billed call becomes a row here, with the key that made it and what it was charged."

# Khu VPS — nhan trang thai + nhat ky (Dot 1 MVP giao dien, 2026-08-26)

