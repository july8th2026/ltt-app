msgid ""
"Mọi phiên điều khiển đều được ghi lại kèm thời gian và địa chỉ bên điều khiển. Máy không còn dùng"
" thì thu hồi, và thu hồi là mất quyền ngay."
msgstr ""
"Every session is recorded with its time and the controlling address. Revoke a machine you no "
"longer use and it loses access immediately."

msgid ""
"Mọi phiên điều khiển đều được ghi lại. Máy nào không còn dùng thì thu hồi, thu hồi xong là máy đó"
" mất quyền ngay."
msgstr "Every session is recorded. Revoke a machine you no longer use and it loses access immediately."

msgid "Mọi phiên đều được ghi lại"
msgstr "Every session is recorded"

msgid "Mọi phong cách"
msgstr "Any style"

#: server/templates/dev_logs.html:19 server/templates/dev_usage.html:105
msgid "Mọi trạng thái"
msgstr "All statuses"

#: apps/ltt_voice
msgid "Mọi tệp tiếng tạo ra đều được đóng một dấu chìm không nghe thấy để nhận diện nội dung do máy tạo."
msgstr "Every audio file produced carries an inaudible watermark identifying it as machine-generated."

msgid "Mọi vùng"
msgstr "Any region"

#: apps/audio_pause/templates/audio_pause.html:68
msgid "Mốc khớp"
msgstr "Matched anchor"

#: apps/audio_pause/templates/audio_pause.html:68
msgid "Mốc trượt"
msgstr "Missed anchor"

msgid "Mỗi chu kỳ đã trả là một dòng trong trang máy của bạn, để đối chiếu chi tiêu."
msgstr "Every cycle you have paid for is a row on your machine page, so you can reconcile spending."

#: apps/auto_scan_video
msgid "Mỗi câu bắt đầu đúng lúc người nói bắt đầu. Phù hợp khi hình có khẩu hình hoặc chữ chạy theo lời."
msgstr ""
"Each line starts exactly when the speaker starts. Best when the picture shows lip movement or on-"
"screen text follows the speech."

msgid "Mỗi dòng một câu…"
msgstr "One sentence per line…"

msgid "Mỗi dòng một tên, dạng: Tên = cách đọc"
msgstr "One name per line, as: Name = pronunciation"

msgid "Mỗi dòng một tệp WAV, tải về trong một tệp nén."
msgstr "One WAV per row, downloaded together as a zip."

#, python-brace-format
msgid "Mỗi dòng thành một tệp. Tối đa {n} dòng."
msgstr "Each line becomes one file. Up to {n} lines."

msgid "Mỗi gói phát hành đều công bố SHA-256 để bạn đối chiếu trước khi chạy."
msgstr "Every release publishes its SHA-256 so you can verify it before running."

#: server/templates/dev_docs.html:37
msgid "Mỗi job và mỗi webhook đều có trường mode để bên nhận phân biệt hai thế giới bằng một endpoint."
msgstr ""
"Every job and every webhook carries a mode field, so a receiver can tell the two worlds apart "
"from a single endpoint."

msgid "Mỗi khối chọn một giọng — người dẫn một giọng, nhân vật một giọng."
msgstr "Pick a voice per block — one for the narrator, another for each character."

#: apps/autosubvideo/jobs.py:84 apps/autosubvideo/routes.py:369
msgid "Mỗi lượt chép lời tối đa 120 phút."
msgstr "Each transcription run is limited to 120 minutes."

#: apps/chataistudio/routes.py:208
msgid "Mỗi lượt chỉ nhận tối đa 3 tệp."
msgstr "Each turn accepts at most 3 files."

#: apps/ltt_voice/templates/ltt_voice_api.html
msgid "Mỗi lượt gọi"
msgstr "Per call"

msgid ""
"Mỗi lượt gọi làm tròn LÊN credit nguyên, tối thiểu 1 credit (100đ) — nên lượt gọi rất nhỏ trả "
"nhiều hơn giá niêm yết."
msgstr ""
"Every call is rounded UP to a whole credit, minimum 1 credit (100đ) — so very small calls pay "
"more than the listed price."

msgid ""
"Mỗi lượt gọi làm tròn LÊN credit nguyên, tối thiểu 1 credit. Nên một lượt rất nhỏ trả nhiều hơn "
"giá niêm yết — xem ví dụ đầu bảng dưới."
msgstr ""
"Every call rounds UP to a whole credit, minimum 1 credit. So a very small call pays more than the"
" list price - see the first example below."

msgid "Mỗi lượt gọi làm tròn lên credit nguyên"
msgstr "Every call rounds up to a whole credit"

msgid "Mỗi lần bạn tạo tiếng nói, lượt đó xuất hiện ở đây để nghe lại và tải về."
msgstr "Every time you generate speech, it shows up here to play back and download."

msgid ""
"Mỗi lần mở console là một vé dùng một lần. Mất kết nối thì phải tải lại trang để xin vé mới — nút"
" “Kết nối lại” làm đúng việc đó."
msgstr ""
"Each console session uses a one-time ticket. If the connection drops you must reload the page to "
"get a new one — that is exactly what “Reconnect” does."

msgid "Mỗi lời gọi có tính tiền sẽ thành một dòng ở đây, kèm khóa nào gọi và đã tính bao nhiêu."
msgstr "Every billed call becomes a row here, with the key that made it and what it was charged."

msgid ""
"Mỗi lời gọi giữ trước một khoản credit theo ước tính cao, rồi quyết toán lại theo số token thật "
"sự đã dùng. Phần giữ dư được hoàn ngay trong cùng lượt gọi."
msgstr ""
"Each call holds credit against a deliberately high estimate, then settles against the tokens "
"actually used. Whatever was held over is refunded within the same call."

msgid "Mỗi lời gọi tới /api/v1 hiện ở đây — thành công lẫn thất bại — để bạn tra khi tích hợp."
msgstr ""
"Every call to /api/v1 shows up here — successes and failures alike — so you can look them up "
"while integrating."

msgid ""
"Mỗi model có trần đầu vào riêng và trần này được công bố ở /api/v1/models. Yêu cầu vượt trần bị "
"từ chối bằng mã 413 kèm con số trần thật, không bị cắt bớt âm thầm."
msgstr ""
"Each model has its own input ceiling, published at /api/v1/models. A request over the ceiling is "
"refused with a 413 carrying the real limit; it is never silently truncated."

msgid ""
"Mỗi máy có một địa chỉ IP riêng ở Singapore, dùng được mọi cổng. Bạn vào máy bằng Remote Desktop "
"như một máy Windows bình thường, hoặc bằng console ngay trong trình duyệt khi cần cứu hộ."
msgstr ""
"Each machine gets its own IP address in Singapore, with every port usable. You connect over "
"Remote Desktop like any Windows machine, or through a console right in your browser when you need"
" rescuing."

msgid ""
"Mỗi máy có một địa chỉ IP riêng ở Singapore, dùng được mọi cổng. Máy chủ đặt tại Việt Nam, đường "
"vào đi qua Singapore."
msgstr ""
"Each machine gets its own IP address in Singapore, with every port usable. The hosts are in "
"Vietnam; traffic reaches them through Singapore."

msgid "Mỗi máy tự sinh khoá của nó và ký từng yêu cầu. Khoá đó không bao giờ được gửi lên máy chủ."
msgstr ""
"Each machine generates its own key and signs every request with it. That key is never sent to the"
" server."

#: apps/audio_pause/templates/audio_pause.html:28
msgid "Mỗi mốc cần `id`, `anchor_text` và `pause_ms`."
msgstr "Each anchor needs `id`, `anchor_text` and `pause_ms`."

msgid "Mỗi mục dưới đây mô tả hành vi đã đo được, không phải ý định."
msgstr "Each item below describes measured behaviour, not intent."

msgid ""
"Mỗi phiên ghi lại thời điểm và địa chỉ bên điều khiển. Thu hồi máy cắt quyền ngay nhưng không xoá"
" nhật ký cũ."
msgstr ""
"Each session records when it happened and where it came from. Revoking a machine cuts its access "
"at once but never erases the old entries."

msgid "Mỗi phiên đều được ghi lại kèm thời gian và địa chỉ bên điều khiển. Xem ở trang Máy của tôi."
msgstr ""
"Every session is recorded with its time and the controlling address. See them on the My devices "
"page."

msgid "Mỗi phiên đều được ghi lại kèm thời gian."
msgstr "Every session is recorded with its timestamp."

#: server/templates/dev_webhooks.html:120
msgid "Mỗi request mang ba header:"
msgstr "Every request carries three headers:"

#: server/templates/dev_webhooks.html:18
msgid "Mỗi sự kiện có id riêng và được ký; giao trùng là an toàn nếu bên nhận khử trùng theo id đó."
msgstr ""
"Each event has its own id and is signed; duplicate deliveries are safe as long as your receiver "
"dedupes on that id."

msgid "Mỗi tài khoản được phục vụ"
msgstr "Each account is served"

msgid "Mỗi tài khoản được phục vụ một lượt tại một thời điểm"
msgstr "One call at a time per account"

msgid "Mỗi tích hợp một project thì báo cáo chi tiêu tách được."
msgstr "One project per integration keeps spend reporting separable."

#: server/templates/dev_projects.html:5
msgid ""
"Mỗi tích hợp một project: thu hồi được riêng, đọc log được riêng. Lưu trữ một project sẽ thu hồi "
"khóa của nó và không đụng tới job hay sổ credit."
msgstr ""
"One project per integration: revoke it on its own, read its logs on its own. Archiving a project "
"revokes its keys and leaves jobs and the credit ledger untouched."

msgid "Một bước không hoàn tất nên chúng tôi dừng lại thay vì giao một bản chưa đạt."
msgstr "A step did not finish, so we stopped rather than deliver a result that is not up to standard."

msgid ""
"Một chương trình nhỏ ghi hộ bạn đúng cấu hình cho cả năm bề mặt, và gỡ ra trả lại đúng trạng thái"
" cũ."
msgstr ""
"A small program that writes the correct config for all five surfaces and, on uninstall, restores "
"exactly what was there before."

msgid "Một câu hỏi ngắn"
msgstr "A short question"

#: platform_core/public_api/governance.py:192
msgid "Một cảnh trong storyboard, kèm prompt và tham số của nó."
msgstr "One scene in a storyboard, with its prompt and parameters."

#: apps/prompt_ai_ommi/routes/projects.py:57
msgid "Một khối prompt đã chọn không còn khả dụng."
msgstr ""

#: apps/ltt_voice/
msgid ""
"Một kịch bản dài hoặc một lô đang soạn: tên, giọng mặc định, trạng thái. Bản thảo của khách, "
"không phải sản phẩm của một job."
msgstr ""
"A long script or a batch being drafted: name, default voice, status. The customer's own draft, "
"not the output of a job."

#: apps/auto_scan_video/che_do_render.py
msgid ""
"Một logo được đặt giờ nằm trọn trong đoạn đã bị cắt bỏ, nên nó sẽ không bao giờ hiện ra. Hãy sửa "
"giờ hoặc xoá logo đó."
msgstr ""
"A timed logo falls entirely inside a stretch that was cut out, so it would never appear. Change "
"its timing or remove it."

msgid "Một lượt agent có nhiều tool"
msgstr "An agent turn with several tools"

msgid ""
"Một lượt chạy đã tính tiền. `actual_cost` và `hold_id` ở đây là câu trả lời cho một tranh chấp "
"hoàn tiền sáu tháng sau."
msgstr ""
"A run that has already been billed. `actual_cost` and `hold_id` here are the answer to a refund "
"dispute six months later."

msgid "Một lượt có dùng công cụ: số vòng đã chạy, lý do dừng, và tổng credit đã giữ/thu/hoàn của cả lượt."
msgstr ""
"One turn that used tools: how many model rounds ran, why it stopped, and the total credit "
"held/charged/refunded for the turn."

msgid ""
"Một lượt gọi rất nhỏ vẫn tính tối thiểu 1 credit. Với lượt gọi nhỏ, số tiền thực trả cao hơn giá "
"niêm yết trên một triệu token."
msgstr ""
"A very small call still costs at least 1 credit. For small calls the effective price is therefore"
" higher than the per-million-token rate."

msgid ""
"Một lượt thi hành: phần chữ đã sinh (kể cả khi bị ngắt), số token đo được và số credit đã giữ/thu"
" — thứ đối chiếu được với sổ tiền."
msgstr ""
"One execution: the text generated so far (even if interrupted), the tokens measured, and the "
"credit held and charged — what reconciles against the ledger."

msgid "Một lượt viết mã"
msgstr "A coding turn"

#: platform_core/public_api/governance.py:161
msgid "Một lần chạy agent: đầu vào, các bước, kết quả."
msgstr "One agent run: input, steps, result."

#: platform_core/public_api/governance.py
msgid ""
"Một lần lồng tiếng: video nguồn của khách, ngôn ngữ, giọng đã chọn. Hết hạn cùng lúc với tệp mà "
"nó trỏ tới."
msgstr ""
"One dubbing run: the customer's source video, language and chosen voice. It expires at the same "
"time as the files it points to."

#: apps/auto_scan_video/che_do_render.py
msgid ""
"Một lớp phủ chữ được đặt giờ nằm trọn trong đoạn đã bị cắt bỏ, nên nó sẽ không bao giờ hiện ra. "
"Hãy sửa giờ hoặc xoá lớp đó."
msgstr ""
"A timed text overlay falls entirely inside a stretch that was cut out, so it would never appear. "
"Change its timing or remove it."

#: apps/taoanh/jobs.py:93 apps/taoanh/jobs.py:207
msgid "Một node Image chỉ nhận tối đa 8 ảnh tham chiếu."
msgstr "An Image node accepts at most 8 reference images."

#: apps/kichban/jobs.py:151
msgid "Một node Text chỉ nhận tối đa 8 ảnh."
msgstr "A Text node accepts at most 8 images."

#: apps/taoanh/templates/image.html:17
msgid "Một phi hành gia khám phá thành phố tương lai, ánh sáng điện ảnh, chi tiết cao"
msgstr "An astronaut exploring a futuristic city, cinematic lighting, highly detailed"

#: platform_core/public_api/governance.py:190
msgid "Một phiên bản của prompt, giữ lại để so sánh và quay lui."
msgstr "One version of a prompt, kept for comparison and rollback."

msgid ""
"Một project gom khóa, nhật ký và chi tiêu của một tích hợp lại — để thu hồi và đọc báo cáo được "
"riêng từng cái."
msgstr ""
"A project groups one integration's keys, logs and spend — so you can revoke and report on each "
"separately."

#: apps/qualitylab/calibration.py:223
msgid "Một rater chỉ được chấm một lần mỗi case."
msgstr ""

#: server/templates/_cam_chon.html:1
msgid ""
"Một số chức năng riêng của ứng dụng như preview selection Edit có thể gọi dịch vụ OpenAI trực "
"tiếp; Browser/Computer Use và dynamic tool discovery chưa được cung cấp cho custom provider. Đây "
"không phải lỗi xác thực của khóa LTT."
msgstr ""
"Some app-specific features such as preview selection Edit may call OpenAI services directly; "
"Browser/Computer Use and dynamic tool discovery are not yet available to custom providers. This "
"is not an LTT key authentication failure."

#: platform_core/public_api/governance.py
msgid ""
"Một thao tác dài đang chạy trên một máy: ai yêu cầu, muốn gì, tới đâu rồi, hỏng vì sao. Khác nhật"
" ký vòng đời ở chỗ nó KẾT THÚC."
msgstr ""
"A long-running operation on one machine: who asked for it, what they wanted, how far it got, and "
"why it failed. Unlike the lifecycle log, this one ENDS."

msgid "Một tài khoản, mọi máy"
msgstr "One account, every machine"

#: apps/taovideo/jobs.py:112
msgid "Một video chỉ nhận tối đa 4 tài nguyên tham chiếu."
msgstr "A video accepts at most 4 reference assets."

msgid "Một video mất khoảng vài chục phút. Bạn có thể đóng trang — kết quả nằm trong Lịch sử."
msgstr "A video takes tens of minutes. You can close the page — the result will be in History."

msgid "Một video mất khoảng vài chục phút. Bạn có thể đóng trang — kết quả sẽ nằm trong Lịch sử."
msgstr "A video takes tens of minutes. You can close this page — the result will appear in History."

msgid "Một vòng ForEach đang chạy."
msgstr "A ForEach loop in progress."

msgid ""
"Một vùng che nằm trọn trong đoạn đã bị cắt bỏ, nên không còn chỗ nào để che. Hãy sửa hoặc xoá "
"vùng đó."
msgstr ""
"One masked area sits entirely inside a stretch that was cut out, so there is nothing left to "
"cover. Please adjust or remove it."

msgid "Một ảnh có ảnh tham chiếu"
msgstr "One image with a reference image"

msgid "Một ảnh từ mô tả"
msgstr "One image from a description"

#: apps/ltt_voice
msgid "MỚI"
msgstr "NEW"

#: apps/taovideo/templates/taovideo.html:76 apps/upscalevideo/templates/upscalevideo.html:85
#: server/templates/home.html:29
msgid "Mới nhất"
msgstr "Newest"

#: apps/taoanh/templates/image.html:31 apps/thumbnail/templates/thumbnail.html:72
#: apps/thumbnail/templates/thumbnail_fragment.html:38 server/templates/dashboard.html:24
#: server/templates/dashboard.html:29 server/templates/dashboard.html:37
#: server/templates/dashboard.html:42 server/templates/nap_khong_thay.html:24
msgid "Mở"
msgstr "Open"

#: server/templates/_cam_chon.html:1
msgid ""
"Mở Edit environment variables for your account của Windows. Trong User variables, tạo LTT_API_KEY"
" với giá trị khóa vừa sao chép. Codex Desktop không có ô Environment riêng; biến phải tồn tại "
"trước lúc mở ứng dụng."
msgstr ""
"Open Windows Edit environment variables for your account. Under User variables, create "
"LTT_API_KEY with the key you just copied. Codex Desktop has no separate Environment field; the "
"variable must exist before the app starts."

#: server/templates/_cam_chon.html:142
msgid "Mở JSON catalog để sao chép toàn bộ"
msgstr "Expand the JSON catalog to copy the complete file"

#: apps/prompt_ai_ommi/templates/prompt_ai_ommi.html:119
msgid "Mở Jobs"
msgstr "Open Jobs"

#: server/templates/_cam_chon.html:134 server/templates/_cam_chon.html:175
msgid "Mở Khóa API"
msgstr "Open API Keys"

#: server/templates/_cam_chon.html:175
msgid ""
"Mở Khóa API, tạo khóa live còn hạn với tools:read và jobs:create; tài khoản cần có credit và "
"quyền gọi model. Sao chép khóa khi nó hiện một lần."
msgstr ""
"Open API Keys and create an unexpired live key with tools:read and jobs:create. Your account "
"needs credit and permission to use the model. Copy the key when it is shown once."

#: server/templates/nap_don.html:48
msgid "Mở PayOS / VietQR"
msgstr "Open PayOS / VietQR"

#: server/templates/_cam_chon.html:192
msgid ""
"Mở Workspace: bật Allow Chat và bật Disable Claude.ai sign-in để cấu hình Gateway được chọn ổn "
"định."
msgstr ""
"Open Workspace: enable Allow Chat and Disable Claude.ai sign-in so the Gateway configuration "
"remains selected."

#: server/templates/home.html:44
msgid "Mở app"
msgstr "Open app"

#: apps/taovideo/templates/taovideo.html:16 apps/taovideo/templates/taovideo.html:81
#: apps/taovideo/templates/taovideo.html:95
msgid "Mở bảng tạo video"
msgstr "Open the video panel"

msgid "Mở console"
msgstr "Open console"

msgid "Mở console ở tab khác rồi để trang này bên cạnh mà làm theo."
msgstr "Open the console in another tab and keep this page beside it to follow along."

msgid "Mở console ở tab mới"
msgstr "Open the console in a new tab"

msgid ""
"Mở console. Máy đã sẵn ở màn hình đầu tiên của trình cài đặt Windows — bạn không phải bấm gì để "
"vào đó."
msgstr ""
"Open the console. The machine is already at the first screen of the Windows installer — you do "
"not have to press anything to get there."

#: server/templates/_cam_chon.html:207
msgid ""
"Mở cuộc trò chuyện mới cho mỗi phép thử, kiểm model ở picker trước khi gửi. Đối chiếu lượt gọi và"
" credit trong Logs/Usage của cổng API LTT. Test connection xanh chưa thay cho kiểm câu trả lời "
"thật."
msgstr ""
"Start a new conversation for each test and check the picker before sending. Check the request and"
" credit in Logs/Usage in the LTT API portal. A passing Test connection does not replace checking "
"an actual answer."

#: server/templates/_header.html:20
msgid "Mở danh sách ứng dụng"
msgstr "Open the app list"

#: platform_core/public_api/notifications.py:198
msgid "Mở khu API"
msgstr "Open the API area"

#: server/templates/_cam_chon.html:1
msgid ""
"Mở lại Codex Desktop và tạo cuộc trò chuyện mới. Luồng cũ lưu model/provider lúc được tạo nên "
"không phải phép kiểm cho cấu hình vừa đổi."
msgstr ""
"Reopen Codex Desktop and create a new conversation. Existing threads store their model/provider "
"when created and do not test the configuration you just changed."

#: server/templates/home.html:31
msgid "Mở menu tài khoản"
msgstr "Open account menu"

#: server/templates/_cam_chon.html:178
msgid ""
"Mở menu ☰ → Help → Troubleshooting → Enable Developer Mode. Sau đó mở Developer → Configure "
"Third-Party Inference."
msgstr ""
"Open menu ☰ → Help → Troubleshooting → Enable Developer Mode. Then open Developer → Configure "
"Third-Party Inference."

#: server/templates/_job_progress.html:20
