msgid "trong giai đoạn thử nghiệm"
msgstr "while in testing"

msgid "Hiện chưa thu credit cho máy ghép. Khi bắt đầu thu, mức giá sẽ hiện ở đây và trong ứng dụng trước khi trừ."
msgstr "Linked machines are not billed yet. When billing starts, the price will appear here and in the app before anything is charged."

msgid "Câu hỏi thường gặp"
msgstr "Common questions"

msgid "Máy ở nhà, sau router — có dùng được không?"
msgstr "Will it work on a home machine behind a router?"

msgid "Được. Máy chủ động kết nối ra relay của LTT nên không cần mở cổng hay IP tĩnh. Chỉ cần máy có Internet và ứng dụng đang chạy."
msgstr "Yes. The machine dials out to the LTT relay, so there is nothing to forward and no static IP needed — it only needs Internet access and the app running."

msgid "Tài khoản trong ứng dụng có phải tài khoản trang web không?"
msgstr "Is the account in the app the same as on the website?"

msgid "Cùng một tài khoản. Bạn đăng nhập trong ứng dụng bằng đúng email và mật khẩu của app.lttstudios.com; credit cũng là cùng một ví."
msgstr "The same account. You sign in to the app with your app.lttstudios.com email and password, and it draws on the same credit balance."

msgid "Làm sao biết ai đã điều khiển máy tôi?"
msgstr "How do I see who controlled my machine?"

msgid "Mỗi phiên đều được ghi lại kèm thời gian."
msgstr "Every session is recorded with its timestamp."

msgid "Xem ở trang Máy của tôi"
msgstr "See it on My devices"

msgid "Tôi bán máy hoặc mất máy thì sao?"
msgstr "What if I sell or lose a machine?"

msgid "Vào <b>Máy của tôi</b> bấm <b>Thu hồi</b>. Máy đó mất quyền kết nối ngay, kể cả khi ứng dụng vẫn còn cài trên đó."
msgstr "Open <b>My devices</b> and press <b>Revoke</b>. That machine loses the right to connect immediately, even with the app still installed on it."

msgid "Ứng dụng có tự cập nhật không?"
msgstr "Does the app update itself?"

msgid "Có. Khi có bản mới, ứng dụng hiện thông báo; bấm một lần là nó tự tải, đối chiếu mã kiểm tra SHA-256 rồi cài đè."
msgstr "Yes. When a new build is out the app tells you; one click and it downloads, checks the SHA-256, and installs over itself."

msgid "iPhone / iPad thì sao?"
msgstr "What about iPhone and iPad?"

msgid "Bản iOS đang chuẩn bị."
msgstr "The iOS build is on the way."

msgid "Trang tải ứng dụng"
msgstr "The download page"

msgid "sẽ hiện nút tải ngay khi sẵn sàng."
msgstr "will show a download button as soon as it is ready."

msgid "Tải file cài"
msgstr "Download the installer"

msgid "Hoặc tải bản zip chạy-không-cài"
msgstr "Or get the portable zip"

msgid "Gọi model ngôn ngữ — trả lời ngay trong request"
msgstr "Call the language model — answered in the request"

msgid "Đây là cửa MỘT bước, khác cửa job ba bước ở trên: không báo giá, không hàng đợi, không hỏi kết quả. Câu trả lời và hoá đơn về cùng lúc."
msgstr "This is a ONE-step door, unlike the three-step job door above: no quote, no queue, no polling. The answer and the bill arrive together."

msgid "Tương thích SDK OpenAI: chỉ cần trỏ base_url vào /api/v1. Một chỗ duy nhất phải thêm là header Idempotency-Key — SDK của OpenAI không tự gửi nó, và ví dụ dưới đây đã có sẵn."
msgstr "OpenAI SDK compatible: point base_url at /api/v1 and you are done, with one exception. You must add an Idempotency-Key header yourself — the OpenAI SDK does not send one — and the examples below already do."

msgid "Cửa chat khác cửa job ở đâu"
msgstr "How the chat door differs from the job door"

msgid "Sáu chỗ. Viết ra đây thay vì để bạn tự vấp:"
msgstr "Six of them, written down here rather than left for you to trip over:"

msgid "Bảy bước trên là cho việc dài — ảnh, video. Riêng model ngôn ngữ có cửa MỘT bước: bỏ qua bước 5, 6, 7 và gọi thẳng"
msgstr "The seven steps above are for long work — images, video. The language model has a ONE-step door: skip steps 5, 6 and 7 and call"

msgid "Ví dụ ở cuối trang."
msgstr "Examples at the bottom of this page."

msgid "Điều khiển máy từ xa"
msgstr "Remote control"

msgid "Máy của bạn, ở bất kỳ đâu bạn đang ngồi"
msgstr "Your machines, from wherever you are sitting"

msgid "Cài ứng dụng lên máy cần điều khiển, đăng nhập cùng một tài khoản LTT, rồi bấm vào nó từ máy khác hoặc từ điện thoại. Không mở cổng, không cần IP tĩnh."
msgstr "Install the app on the machine you want to reach, sign in with the same LTT account, then click it from another computer or from your phone. No port forwarding, no static IP."

msgid "Không mở cổng, không VPN"
msgstr "No port forwarding, no VPN"

msgid "Mọi phiên đều được ghi lại"
msgstr "Every session is recorded"

msgid "Mã nguồn mở, AGPL-3.0"
msgstr "Open source, AGPL-3.0"

msgid "bản cài sẵn sàng"
msgstr "builds ready to install"

msgid "cổng phải mở trên router"
msgstr "ports to open on your router"

msgid "phiên điều khiển được ghi nhật ký"
msgstr "of sessions are logged"

msgid "Vì sao dùng"
msgstr "Why use it"

msgid "Ba thứ khiến nó khác"
msgstr "Three things that set it apart"

msgid "Không phải danh sách tính năng — đây là ba việc bạn sẽ đụng tới ngay ngày đầu."
msgstr "Not a feature list — these are the three things you will meet on day one."

msgid "Không mở cổng, không cần IP tĩnh, không VPN. Máy tự kết nối ra relay của LTT, kể cả khi nằm sau router nhà hay đang dùng 4G."
msgstr "No port forwarding, no static IP, no VPN. Each machine dials out to the LTT relay, even behind a home router or on mobile data."

msgid "Đăng nhập cùng tài khoản LTT trên từng máy. Danh sách hiện ngay trong ứng dụng kèm chỉ báo máy nào đang bật — không phải gõ ID, không phải dán mật khẩu."
msgstr "Sign in with the same LTT account on each machine. The list appears right inside the app showing which ones are online — no ID to type, no password to paste."

msgid "Mọi phiên điều khiển đều được ghi lại kèm thời gian và địa chỉ bên điều khiển. Máy không còn dùng thì thu hồi, và thu hồi là mất quyền ngay."
msgstr "Every session is recorded with its time and the controlling address. Revoke a machine you no longer use and it loses access immediately."

msgid "Chọn máy của bạn"
msgstr "Pick your platform"

msgid "Cài lên máy cần điều khiển từ xa, rồi cài lên máy hoặc điện thoại bạn đang ngồi."
msgstr "Install it on the machine you want to reach, then on the computer or phone you are sitting at."

msgid "Bốn bước, một lần duy nhất"
msgstr "Four steps, once"

msgid "Cài lên máy cần điều khiển"
msgstr "Install it on the machine you want to reach"

msgid "Tải bản đúng hệ điều hành rồi chạy file cài. Không cần gỡ bản cũ."
msgstr "Download the build for its operating system and run the installer. No need to uninstall an older version first."

msgid "Đăng nhập ngay trong ứng dụng"
msgstr "Sign in inside the app"

msgid "Dùng đúng email và mật khẩu bạn đăng nhập trang này — cùng một tài khoản, cùng một ví credit."
msgstr "The same email and password you use on this site — one account, one credit balance."

msgid "Cài lên máy bạn đang ngồi"
msgstr "Install it where you are sitting"

msgid "Máy tính khác, hoặc điện thoại. Đăng nhập cùng tài khoản đó."
msgstr "Another computer, or your phone. Sign in with that same account."

msgid "Bấm vào máy trong danh sách"
msgstr "Click a machine in the list"

msgid "Không cần gõ ID, không cần dán mật khẩu một lần."
msgstr "No ID to type, no one-time password to paste."

msgid "An toàn & riêng tư"
msgstr "Security & privacy"

msgid "Ai thấy được gì"
msgstr "Who can see what"

msgid "Đây là phần mềm nhìn thấy màn hình của bạn, nên nó nợ bạn câu trả lời rõ ràng."
msgstr "This is software that sees your screen, so it owes you a straight answer."

msgid "Khoá riêng không rời máy"
msgstr "The private key never leaves the machine"

msgid "Mỗi máy tự sinh khoá của nó và ký từng yêu cầu. Khoá đó không bao giờ được gửi lên máy chủ."
msgstr "Each machine generates its own key and signs every request with it. That key is never sent to the server."

msgid "Màn hình không đi qua trình duyệt"
msgstr "Your screen does not go through a browser"

msgid "Hình ảnh đi thẳng giữa hai ứng dụng qua relay của LTT. Trang web này chỉ lo tài khoản, credit và hướng dẫn."
msgstr "The picture travels directly between the two apps over the LTT relay. This website only handles accounts, credit and documentation."

msgid "Nhật ký không sửa được"
msgstr "The log cannot be edited"

msgid "Mỗi phiên ghi lại thời điểm và địa chỉ bên điều khiển. Thu hồi máy cắt quyền ngay nhưng không xoá nhật ký cũ."
msgstr "Each session records when it happened and where it came from. Revoking a machine cuts its access at once but never erases the old entries."

msgid "Mã nguồn mở"
msgstr "Open source"

msgid "LTT Nexus dựa trên RustDesk theo giấy phép AGPL-3.0; bản sửa của chúng tôi được công bố công khai."
msgstr "LTT Nexus is based on RustDesk under the AGPL-3.0 licence; our modified source is published openly."

msgid "Tính theo máy, không tính theo giờ"
msgstr "Billed per machine, not per hour"

msgid "Tính theo số máy bạn ghép vào tài khoản — không theo số phiên, không theo số phút điều khiển. Máy nào thu hồi thì tháng sau không thu nữa."
msgstr "Billed by how many machines are linked to your account — not by sessions, not by minutes. Revoke one and it stops being billed the following month."

msgid "Hiện chưa thu credit cho máy ghép. Khi bắt đầu thu, mức giá sẽ hiện ở đây và trong ứng dụng trước khi trừ đồng nào."
msgstr "Linked machines are not billed yet. When billing starts, the price will appear here and in the app before anything is charged."

msgid "Những điều hay được hỏi"
msgstr "Things people ask"

msgid "Mỗi phiên đều được ghi lại kèm thời gian và địa chỉ bên điều khiển. Xem ở trang Máy của tôi."
msgstr "Every session is recorded with its time and the controlling address. See them on the My devices page."

msgid "Vào Máy của tôi rồi bấm Thu hồi. Máy đó mất quyền kết nối ngay, kể cả khi ứng dụng vẫn còn cài trên đó."
msgstr "Open My devices and press Revoke. That machine loses the right to connect immediately, even with the app still installed on it."

msgid "Có, trên Windows và macOS: bấm một lần là nó tự tải, đối chiếu mã kiểm tra SHA-256 rồi cài đè. Android và iOS phải xác nhận ở màn hình cài đặt của hệ điều hành — đó là giới hạn của hai hệ đó."
msgstr "Yes, on Windows and macOS: one click and it downloads, checks the SHA-256, and installs over itself. Android and iOS require you to confirm in the system installer — that is a limit of those platforms."

msgid "Bản iOS cài được qua SideStore hoặc Sideloadly. Apple không cho cài thẳng file .ipa chưa ký từ Safari — đó là giới hạn của iOS, không phải của ứng dụng."
msgstr "The iOS build installs through SideStore or Sideloadly. Apple does not allow an unsigned .ipa to be installed straight from Safari — that is a limit of iOS, not of the app."

msgid "Cài mất chưa tới hai phút"
msgstr "Installing takes under two minutes"

msgid "Tải bản cho máy bạn, đăng nhập, và máy sẽ hiện ra ở mọi thiết bị khác của bạn."
msgstr "Download the build for your machine, sign in, and it appears on every other device you own."

msgid "Máy của bạn, ở bất kỳ đâu"
msgstr "Your machines, wherever you are"

msgid "Giá API model ngôn ngữ"
msgstr "Language model API pricing"

msgid "Tính theo token, trả theo lượng dùng thật. Không thuê bao, không phí tối thiểu hằng tháng."
msgstr "Charged per token, for what you actually use. No subscription, no monthly minimum."

msgid "phiên bản giá"
msgstr "price list version"

msgid "Loại token"
msgstr "Token type"

msgid "credit / 1 triệu token"
msgstr "credits / 1M tokens"

msgid "tương đương"
msgstr "equals"

msgid "Token vào"
msgstr "Input tokens"

msgid "câu hỏi, ngữ cảnh, định nghĩa tool"
msgstr "your question, the context, tool definitions"

msgid "đ"
msgstr "đ"

msgid "Token vào lấy lại từ cache"
msgstr "Input tokens served from cache"

msgid "Token ra"
msgstr "Output tokens"

msgid "câu trả lời, kể cả phần suy nghĩ"
msgstr "the answer, including any reasoning"

msgid "Mỗi lượt gọi làm tròn LÊN credit nguyên, tối thiểu 1 credit. Nên một lượt rất nhỏ trả nhiều hơn giá niêm yết — xem ví dụ đầu bảng dưới."
msgstr "Every call rounds UP to a whole credit, minimum 1 credit. So a very small call pays more than the list price - see the first example below."

msgid "Ba ví dụ chi phí thật"
msgstr "Three real cost examples"

msgid "Tính bằng đúng hàm ra hoá đơn, không phải bằng một phép nhân riêng."
msgstr "Computed by the same function that produces your bill, not by a separate multiplication."

msgid "Lượt gọi"
msgstr "Call"

msgid "token vào"
msgstr "input tokens"

msgid "token ra"
msgstr "output tokens"

msgid "tiền"
msgstr "cost"

msgid "Giá API tạo ảnh"
msgstr "Image API pricing"

msgid "Model ảnh chạy trên máy của chúng tôi. Tính theo ảnh, và chỉ tính những ảnh thật sự sinh ra được."
msgstr "The image model runs on our own hardware. Charged per image, and only for images actually produced."

msgid "Loại ảnh"
msgstr "Image type"

msgid "credit / ảnh"
msgstr "credits / image"

msgid "Ảnh từ mô tả"
msgstr "Image from a description"

msgid "Ảnh có ảnh tham chiếu"
msgstr "Image with a reference image"

msgid "Ảnh tham chiếu đắt gấp %(n)d lần vì máy vẽ lâu hơn khoảng 3,3 lần ở cùng số bước. Tối đa %(m)d ảnh một lượt."
msgstr "Reference images cost %(n)d times more because the machine takes about 3.3 times as long at the same step count. Up to %(m)d images per call."

msgid "Xin 4 ảnh mà chỉ ra 2 thì trả tiền 2"
msgstr "Ask for 4 images, get 2, pay for 2"

msgid "Hệ thống giữ trước một mức trần theo số ảnh bạn xin, rồi hoàn lại phần chênh khi lượt vẽ xong. Lượt không sinh được ảnh nào được hoàn đủ."
msgstr "We hold a ceiling based on the number of images you ask for, then refund the difference once the run finishes. A run that produces no image is refunded in full."

msgid "Ba điều nên biết trước khi dùng"
msgstr "Three things worth knowing first"

msgid "Trả cho thứ đã sinh ra, không trả cho thứ đã xin"
msgstr "You pay for what was produced, not for what you asked for"

msgid "Xin max_tokens 8.000 mà model chỉ trả lời 200 token thì bạn trả cho 200. Hệ thống giữ trước một mức trần rồi hoàn lại phần chênh ngay khi lượt gọi xong."
msgstr "Ask for max_tokens 8,000 and the model answers in 200 tokens, and you pay for 200. We hold a ceiling first, then refund the difference as soon as the call finishes."

msgid "Ngắt giữa chừng vẫn tính phần đã sinh"
msgstr "Cutting a stream short still charges what was generated"

msgid "Với luồng streaming, nếu bạn đóng kết nối giữa chừng thì phần chữ đã sinh ra vẫn tính tiền — GPU đã chạy rồi. Gọi lại là một lượt sinh mới, và tính tiền mới."
msgstr "With streaming, closing the connection mid-answer still charges for the text already generated - the GPU has already done that work. Calling again is a new generation, and a new charge."

msgid "Không đo được thì không thu"
msgstr "No measurement, no charge"

msgid "Nếu hệ thống không đọc được số token đã dùng, lượt đó được hoàn đủ và tính 0 đồng. Thu tiền mà không có bằng chứng thì tệ hơn mất một ít tiền."
msgstr "If we cannot read how many tokens were used, that call is refunded in full and costs nothing. Charging without evidence is worse than losing a little money."

msgid "tạo khoá API"
msgstr "create an API key"

msgid "cắm vào Codex hoặc Claude"
msgstr "plug it into Codex or Claude"

msgid "Khoá dùng được ngay với thư viện OpenAI, Codex CLI, Claude Code và Claude Desktop — không cần thư viện riêng."
msgstr "The key works right away with the OpenAI library, Codex CLI, Claude Code and Claude Desktop - no special library needed."

msgid "Một câu hỏi ngắn"
msgstr "A short question"

msgid "Một lượt viết mã"
msgstr "A coding turn"

msgid "Một lượt agent có nhiều tool"
msgstr "An agent turn with several tools"

msgid "Một ảnh từ mô tả"
msgstr "One image from a description"

msgid "Bốn ảnh từ mô tả"
msgstr "Four images from a description"

msgid "Một ảnh có ảnh tham chiếu"
msgstr "One image with a reference image"

msgid "Cắm vào Codex / Claude"
msgstr "Plug into Codex / Claude"

msgid ""
"Máy khách đã thuê: gói, đĩa, hệ điều hành, vmid. Đây là phía đối ứng "
"của hoá đơn — mất nó thì không đối soát được khách trả tiền cho cái "
"gì."
msgstr ""
"The machines a customer rented: plan, disk, operating system, vmid. "
"This is the counterpart of the invoice — lose it and there is no way "
"to reconcile what the customer paid for."

msgid ""
"Địa chỉ IP đã cấp cho máy nào, từ lúc nào. Là thứ duy nhất trả lời "
"được một yêu cầu về lạm dụng từ bên ngoài."
msgstr ""
"Which IP address was issued to which machine, and from when. It is "
"the only thing that can answer an abuse report from outside."

msgid ""
"Vé mở console máy ảo. Lưu SHA-256 của vé, không lưu vé. Hết hạn sau "
"60 giây và bị xoá ngay khi dùng."
msgstr ""
"Tickets that open a VM console. The SHA-256 of the ticket is stored, "
"never the ticket. It expires after 60 seconds and is deleted the "
"moment it is used."

msgid ""
"Nhật ký vòng đời một máy — thứ trả lời \"vì sao máy tôi bị tắt\". "
"Chính bảng này ghi rằng nó tồn tại vì log xoay vòng rồi mất, còn câu "
"hỏi của khách thì đến sau ba tháng."
msgstr ""
"The lifecycle log of a machine — the thing that answers \"why was my "
"machine shut down\". This very table records that it exists because "
"logs rotate away, while the customer's question arrives three months "
"later."

msgid ""
"Ai đã điều khiển máy nào, từ IP nào, bắt đầu và kết thúc lúc nào. "
"Chỉ giữ dấu vân tay một chiều của vé, không giữ vé."
msgstr ""
"Who controlled which machine, from which IP, and when the session "
"started and ended. Only a one-way fingerprint of the ticket is kept, "
"never the ticket."

msgid ""
"Máy nào đã từng được tin, ghép lúc nào, ai thu hồi. Thu hồi ghi "
"`revoked_at` chứ không xoá dòng — xoá là xoá luôn câu trả lời. Chỉ "
"giữ khoá CÔNG KHAI, không bao giờ có khoá riêng."
msgstr ""
"Which machines were ever trusted, when they were paired, and who "
"revoked them. Revoking writes `revoked_at` instead of deleting the "
"row — deleting it would delete the answer too. Only PUBLIC keys are "
"kept; a private key is never held here."

msgid ""
"Mã ghép đã dùng là mẩu kiểm toán 'máy này ghép lúc nào, từ IP nào'; "
"mã hết hạn không ai dùng thì không kiểm toán gì và rụng sau 30 ngày. "
"Chỉ giữ digest, không giữ mã."
msgstr ""
"A used pairing code is the audit trail for 'when this machine was "
"paired, and from which IP'; an expired code nobody used audits "
"nothing and drops after 30 days. Only the digest is kept, never the "
"code."

msgid ""
"Trang này đọc được không cần tài khoản. Để gọi thật, bạn cần một "
"khóa API — và khóa thì cần tài khoản."
msgstr ""
"You can read this page without an account. To make a real call you "
"need an API key — and a key needs an account."

msgid "Đăng ký lấy khóa"
msgstr "Sign up for a key"

msgid "Tôi đã có tài khoản"
msgstr "I already have an account"

msgid "Xem giá"
msgstr "See pricing"

msgid "Đã có project"
msgstr "Project created"

msgid "Đã có khóa đang hoạt động"
msgstr "Key is active"

msgid "Đã gọi được lần đầu"
msgstr "First call succeeded"

msgid "Gọi thử — lệnh này không tốn credit:"
msgstr "Make a test call — this one costs no credit:"

msgid "(cần khóa ở bước trên trước)"
msgstr "(needs the key from the step above)"

msgid "Đặt khóa vào biến môi trường trước:"
msgstr "Put your key in an environment variable first:"

msgid "Trả 200 là xong — xác thực, phạm vi và hạn mức đều đúng."
msgstr ""
"A 200 means you are done — authentication, scopes and limits are all "
"correct."

msgid "Bạn đã gọi được. Những nơi hay dùng:"
msgstr "You are calling successfully. The places you will use most:"

msgid "Hướng dẫn đầy đủ"
msgstr "Full guide"

msgid "Xem có những công cụ gì"
msgstr "See what tools exist"

msgid ""
"Máy chủ chưa cấu hình xong để cấp khóa. Đây là lỗi phía chúng tôi, "
"không phải của bạn — chúng tôi đã được báo. Vui lòng thử lại sau."
msgstr ""
"This server is not finished being configured to issue keys. That is "
"a fault on our side, not yours — we have been notified. Please try "
"again later."

msgid "Khóa live ở đây tiêu credit thật."
msgstr "A live key here spends real credit."

msgid ""
"Muốn thử không mất tiền thì dùng khóa Test — nó đi qua đúng chuỗi "
"này nhưng không gọi nhà cung cấp và không chạm vào sổ credit."
msgstr ""
"To try it for free, use a Test key — it goes through exactly this "
"chain but calls no provider and never touches the credit ledger."

msgid "Bạn chưa có khóa nào dùng được."
msgstr "You have no usable key yet."

msgid ""
"Trang này không tự điền khóa hộ bạn được — máy chủ chỉ giữ dấu vân "
"tay một chiều, nên chính chúng tôi cũng không đọc lại được khóa đã "
"cấp."
msgstr ""
"This page cannot fill the key in for you — the server keeps only a "
"one-way fingerprint, so not even we can read back a key we issued."

msgid "Tạo một khóa Test"
msgstr "Create a Test key"

msgid "chọn Môi trường = Test — không tốn credit nào."
msgstr "set Environment = Test — it costs no credit at all."

msgid "Khóa đang dùng được của bạn — dán chuỗi bí mật của một trong số này:"
msgstr "Your usable keys — paste the secret of one of these:"

msgid "không tốn credit"
msgstr "costs no credit"

msgid "Không nhớ chuỗi bí mật? Nó chỉ hiện một lần lúc tạo —"
msgstr "Cannot remember the secret? It is shown once, at creation —"

msgid "tạo khóa mới"
msgstr "create a new key"

msgid "rồi thu hồi khóa cũ."
msgstr "then revoke the old one."

msgid "LTT VPS — máy chủ ảo Windows"
msgstr "LTT VPS — Windows virtual machines"

msgid "Máy chủ ảo Windows, trả bằng credit"
msgstr "Windows virtual machines, paid with credit"

msgid ""
"Thuê máy chủ ảo Windows, tạo xong trong vài phút, trả bằng credit. "
"Bạn tự chọn cấu hình và vùng đặt máy."
msgstr ""
"Rent a Windows virtual machine, ready in minutes, paid with credit. "
"You pick the size and the region."

msgid "Thuê một máy Windows trong khoảng 20 giây"
msgstr "Rent a Windows machine in about 20 seconds"

msgid "Chỉ từ"
msgstr "From"

msgid "30 ngày"
msgstr "30 days"

msgid "Gói"
msgstr "Plan"

msgid "Chọn"
msgstr "Select"

msgid "Chọn gói này"
msgstr "Choose this plan"

msgid "nên chọn"
msgstr "recommended"

msgid "Giá / 30 ngày"
msgstr "Price / 30 days"

msgid "Băng thông"
msgstr "Bandwidth"

msgid "băng thông"
msgstr "bandwidth"

msgid "Hệ điều hành"
msgstr "Operating system"

msgid "Địa chỉ"
msgstr "Address"

msgid "Địa chỉ IP"
msgstr "IP address"

msgid "Đĩa của máy"
msgstr "Machine disk"

msgid "đĩa"
msgstr "disk"

msgid "Còn trống"
msgstr "Available"

msgid "Còn lại"
msgstr "Remaining"

msgid "Số dư"
msgstr "Balance"

msgid "Sẽ trừ"
msgstr "Will charge"

msgid "Tóm tắt"
msgstr "Summary"

msgid "Việt Nam"
msgstr "Vietnam"

msgid "riêng, tại %(noi)s"
msgstr "dedicated, in %(noi)s"

msgid "— vào bằng %(cong)s"
msgstr "— connect on %(cong)s"

msgid "VPS Nhỏ"
msgstr "VPS Small"

msgid "VPS Vừa"
msgstr "VPS Medium"

msgid "VPS Lớn"
msgstr "VPS Large"

msgid ""
"Chạy được Windows Server 2016 hoặc 2022 bản Core (không có giao diện "
"đồ hoạ). Hợp khi bạn chỉ cần một máy chạy phần mềm hoặc script nền."
msgstr ""
"Runs Windows Server 2016 or 2022 Core (no graphical desktop). A good "
"fit when all you need is a machine running background software or "
"scripts."

msgid ""
"Chạy được mọi bản trong danh mục: Server 2016 và 2022 có giao diện, "
"hoặc Windows 10 LTSC. Đây là gói phần lớn người dùng nên chọn."
msgstr ""
"Runs every edition in the catalogue: Server 2016 and 2022 with a "
"desktop, or Windows 10 LTSC. This is the plan most people should "
"pick."

msgid ""
"Gấp đôi CPU và RAM của gói Vừa, đĩa 80 GB. Hợp khi bạn chạy phần mềm "
"nặng hoặc nhiều việc cùng lúc — không phải để cài thêm bản Windows "
"nào khác."
msgstr ""
"Twice the CPU and RAM of Medium, with an 80 GB disk. A good fit for "
"heavy software or several jobs at once — not for installing any "
"additional Windows edition."

msgid "Gói không hợp lệ."
msgstr "Invalid plan."

msgid "Đọc trước khi thuê"
msgstr "Read before you rent"

msgid "Đọc"
msgstr "Read"

msgid "Điều khoản LTT VPS"
msgstr "LTT VPS Terms"

msgid "trước khi thuê — nó nói rõ những gì dịch vụ này KHÔNG cam kết."
msgstr "before you rent — it spells out what this service does NOT promise."

msgid ""
"Dịch vụ chạy theo chế độ best effort — chúng tôi không cam kết thời "
"gian hoạt động. Máy chủ có thể khởi động lại để bảo trì."
msgstr ""
"The service runs on a best-effort basis — we make no uptime "
"commitment. Hosts may be restarted for maintenance."

msgid ""
"Mỗi máy có một địa chỉ IP riêng ở Singapore, dùng được mọi cổng. Máy "
"chủ đặt tại Việt Nam, đường vào đi qua Singapore."
msgstr ""
"Each machine gets its own IP address in Singapore, with every port "
"usable. The hosts are in Vietnam; traffic reaches them through "
"Singapore."

msgid ""
"Dung lượng đĩa là hạn mức trên kho lưu trữ dùng chung, không phải ổ "
"cứng cấp riêng. Bạn dùng tới đâu chiếm tới đó."
msgstr ""
"Disk size is an allowance on shared storage, not a dedicated drive. "
"You occupy only what you actually use."

msgid ""
"Băng thông có hạn mức theo gói. Vượt hạn mức thì bị giảm tốc, không "
"bị tính thêm tiền."
msgstr ""
"Bandwidth is capped per plan. Going over it means being throttled, "
"never being charged extra."

msgid ""
"Ảnh chụp hằng tuần, giữ 1 bản. Ảnh chụp nằm trên cùng kho lưu trữ "
"với máy — nó cứu bạn khỏi xoá nhầm hoặc một bản vá hỏng, nhưng KHÔNG "
"thay thế bản sao lưu của riêng bạn."
msgstr ""
"Weekly snapshot, one kept. The snapshot sits on the same storage as "
"the machine — it saves you from a mistaken deletion or a bad patch, "
"but it is NOT a substitute for your own backup."

msgid ""
"Giá KHÔNG bao gồm giấy phép Windows. Chúng tôi cấp đĩa cài (bản "
"Evaluation của Microsoft); bạn tự cài và tự chịu trách nhiệm về giấy "
"phép."
msgstr ""
"The price does NOT include a Windows licence. We provide the install "
"media (Microsoft's Evaluation edition); you install it yourself and "
"are responsible for licensing."

msgid "IP riêng, dùng được mọi cổng"
msgstr "Dedicated IP, every port usable"

msgid "Tạo xong trong khoảng 20 giây"
msgstr "Ready in about 20 seconds"

msgid "Không hợp đồng, xoá là dừng"
msgstr "No contract — delete it and it stops"

msgid "Chúng tôi không biết mật khẩu của bạn"
msgstr "We never know your password"

msgid ""
"Mỗi máy có một địa chỉ IP riêng ở Singapore, dùng được mọi cổng. Bạn "
"vào máy bằng Remote Desktop như một máy Windows bình thường, hoặc "
"bằng console ngay trong trình duyệt khi cần cứu hộ."
msgstr ""
"Each machine gets its own IP address in Singapore, with every port "
"usable. You connect over Remote Desktop like any Windows machine, or "
"through a console right in your browser when you need rescuing."

msgid "Tạo xong trong khoảng 20 giây, rồi bạn tự cài Windows qua console."
msgstr ""
"Ready in about 20 seconds, then you install Windows yourself through "
"the console."

msgid ""
"Bạn tự đặt tài khoản và mật khẩu của mình — chúng tôi không biết mật "
"khẩu của bạn."
msgstr "You set your own account and password — we never know your password."

msgid ""
"Trả theo chu kỳ 30 ngày bằng credit. Không hợp đồng, không ràng "
"buộc; xoá máy là dừng các chu kỳ sau."
msgstr ""
"Billed in 30-day cycles with credit. No contract, no lock-in; delete "
"the machine and no further cycle is charged."

msgid "Tạo tài khoản để thuê máy"
msgstr "Create an account to rent a machine"

msgid "Tạo máy"
msgstr "Create machine"

msgid "Tạo máy mới"
msgstr "Create a machine"

msgid "Bước 1 · Chọn máy"
msgstr "Step 1 · Choose a machine"

msgid "Bước 2 · Chọn hệ điều hành"
msgstr "Step 2 · Choose an operating system"

msgid "Hiện chưa nhận máy mới."
msgstr "Not accepting new machines right now."

msgid "Hiện chưa nhận máy mới. Bảng giá dưới đây vẫn đúng."
msgstr ""
"Not accepting new machines right now. The prices below are still "
"current."

msgid "Hiện đã hết chỗ cho cấu hình này."
msgstr "No capacity left for this size."

msgid "Đã hết chỗ cho cấu hình này. Vui lòng chọn gói nhỏ hơn."
msgstr "No capacity left for this size. Please pick a smaller plan."

msgid "Chưa có hệ điều hành nào phù hợp với cấu hình này."
msgstr "No operating system fits this size yet."

msgid "chưa có hệ điều hành"
msgstr "no operating system"

msgid "còn chỗ"
msgstr "available"

msgid "hết chỗ"
msgstr "full"

msgid "Hệ thống đang bận, chưa nhận máy mới. Thử lại sau."
msgstr "The system is busy and is not taking new machines. Try again later."

msgid "Hệ thống đang bận, thử lại sau."
msgstr "The system is busy; try again later."

msgid "Vùng bạn chọn hiện không nhận máy mới."
msgstr "The region you picked is not taking new machines right now."

msgid "Không đủ credit: %(ly_do)s"
msgstr "Not enough credit: %(ly_do)s"

msgid "Máy đang bận hoặc đã bị xoá."
msgstr "The machine is busy or has been deleted."

msgid "Máy chủ không nhận lệnh lúc này. Thử lại sau ít phút."
msgstr ""
"The host is not accepting commands right now. Try again in a few "
"minutes."

msgid "Windows Server 2016 (có giao diện)"
msgstr "Windows Server 2016 (with desktop)"

msgid "Windows Server 2022 (có giao diện)"
msgstr "Windows Server 2022 (with desktop)"

msgid "Bản cũ hơn 2022. Chọn nó khi phần mềm của bạn cần đúng đời này."
msgstr ""
"Older than 2022. Pick it when your software needs this exact "
"generation."

msgid "Không có giao diện đồ hoạ. Nhẹ nhất trong các bản Windows."
msgstr "No graphical desktop. The lightest Windows edition."

msgid "có giao diện đồ hoạ như Windows thường."
msgstr "has a graphical desktop like ordinary Windows."

msgid "chỉ có dòng lệnh, nhẹ hơn nhiều."
msgstr "command line only, and much lighter."

msgid "Chọn phiên bản:"
msgstr "Choose an edition:"

msgid "Chọn nhầm thì phải cài lại, nên đọc kỹ dòng này."
msgstr ""
"Picking the wrong one means reinstalling, so read this line "
"carefully."

msgid "Giữ nguyên hệ điều hành"
msgstr "Keep the current operating system"

msgid "Đang tạo"
msgstr "Creating"

msgid "đang chuẩn bị"
msgstr "preparing"

msgid "đang chuẩn bị…"
msgstr "preparing…"

msgid "Đã tắt"
msgstr "Stopped"

msgid "Bị tạm dừng"
msgstr "Suspended"

msgid "Đã xoá"
msgstr "Deleted"

msgid "đang giảm tốc"
msgstr "throttled"

msgid "Bật"
msgstr "Start"

msgid "Khởi động lại"
msgstr "Restart"

msgid "Quản lý"
msgstr "Manage"

msgid "Về trang máy"
msgstr "Back to the machine"

msgid "Chưa có gì."
msgstr "Nothing yet."

msgid "Máy đang được tạo. Tải lại trang sau vài phút."
msgstr "The machine is being created. Reload the page in a few minutes."

msgid ""
"Máy đang bị treo do hết hạn thanh toán. Nạp credit và gia hạn để "
"dùng lại."
msgstr ""
"The machine is suspended because payment lapsed. Top up credit and "
"renew to use it again."

msgid ""
"Máy đang bị giảm tốc vì đã vượt hạn mức. Không bị tính thêm tiền — "
"tốc độ trở lại bình thường khi sang chu kỳ mới."
msgstr ""
"The machine is throttled because it went over its allowance. Nothing "
"extra is charged — full speed returns with the next cycle."

msgid "Băng thông chu kỳ này"
msgstr "Bandwidth this cycle"

msgid "Trả tới"
msgstr "Paid until"

msgid "Trả cho tới"
msgstr "Paid until"

msgid "còn %(n)s ngày"
msgstr "%(n)s days left"

msgid "Mở console"
msgstr "Open console"

msgid "Mở console ở tab mới"
msgstr "Open the console in a new tab"

msgid "Mở console ở tab khác rồi để trang này bên cạnh mà làm theo."
msgstr ""
"Open the console in another tab and keep this page beside it to "
"follow along."

msgid "Không mở được console lúc này. Thử lại sau ít phút."
msgstr "The console cannot be opened right now. Try again in a few minutes."

msgid ""
"Dùng khi bạn không vào được bằng RDP — ví dụ vừa đổi tường lửa trong "
"máy."
msgstr ""
"Use it when you cannot get in over RDP — for example right after "
"changing the firewall inside the machine."

msgid "Hướng dẫn cài Windows"
msgstr "How to install Windows"

msgid "Cài Windows"
msgstr "Install Windows"

msgid "Trước khi bắt đầu"
msgstr "Before you start"

msgid ""
"Máy của bạn là một máy trống đã gắn sẵn đĩa cài Windows. Bạn tự chạy "
"trình cài đặt và tự đặt tài khoản của mình — chúng tôi không biết "
"mật khẩu của bạn và không đặt lại được nó."
msgstr ""
"Your machine is an empty one with the Windows install media already "
"attached. You run the installer and create your own account — we "
"never know your password and cannot reset it."

msgid ""
"Máy giao cho bạn là máy trống có đĩa cài — bạn tự đặt tài khoản và "
"mật khẩu của mình."
msgstr ""
"The machine you get is empty with install media attached — you set "
"your own account and password."

msgid ""
"Bạn KHÔNG cần nạp thêm driver nào. Máy dùng ổ SATA và card mạng "
"e1000, Windows nhận sẵn cả hai."
msgstr ""
"You do NOT need to load any driver. The machine uses a SATA disk and "
"an e1000 network card, and Windows recognises both out of the box."

msgid ""
"Mở console. Máy đã sẵn ở màn hình đầu tiên của trình cài đặt Windows "
"— bạn không phải bấm gì để vào đó."
msgstr ""
"Open the console. The machine is already at the first screen of the "
"Windows installer — you do not have to press anything to get there."

msgid ""
"Khi thấy dòng “Press any key to boot from CD or DVD…”, đừng bấm gì "
"cả."
msgstr "When you see “Press any key to boot from CD or DVD…”, press nothing."

msgid ""
"Bấm vào đó là quay lại đầu trình cài đặt. Không bấm thì sau vài giây "
"máy tự đi tiếp."
msgstr ""
"Pressing a key sends you back to the start of the installer. Leave "
"it and the machine carries on by itself after a few seconds."

msgid "Chọn ngôn ngữ, bàn phím → Next → Install now."
msgstr "Choose language and keyboard → Next → Install now."

msgid "Chấp nhận điều khoản → chọn Custom: Install Windows only (advanced)."
msgstr ""
"Accept the licence terms → choose Custom: Install Windows only "
"(advanced)."

msgid "Chọn ổ đĩa duy nhất trong danh sách (Drive 0) → Next."
msgstr "Select the only disk in the list (Drive 0) → Next."

msgid "Chờ cài. Máy sẽ tự khởi động lại vài lần."
msgstr "Wait for the install. The machine restarts itself a few times."

msgid "Cài xong mất khoảng 15–25 phút, phần lớn là ngồi chờ."
msgstr "The install takes roughly 15–25 minutes, most of it waiting."

msgid ""
"Đặt mật khẩu cho tài khoản Administrator. Đây là mật khẩu của riêng "
"bạn — hãy lưu lại ngay, chúng tôi không giữ bản nào và không đặt lại "
"được."
msgstr ""
"Set a password for the Administrator account. This password is yours "
"alone — save it now: we keep no copy and cannot reset it."

msgid ""
"Remote Desktop mặc định TẮT trong Windows. Không bật thì bạn chỉ vào "
"được bằng console."
msgstr ""
"Remote Desktop is OFF by default in Windows. Without turning it on, "
"the console is your only way in."

msgid ""
"Bật Remote Desktop để vào máy từ nhà. Mở PowerShell trong máy và "
"dán:"
msgstr ""
"Turn on Remote Desktop so you can reach the machine from home. Open "
"PowerShell inside the machine and paste:"

msgid "Từ máy của bạn, mở Remote Desktop (mstsc) và nối tới"
msgstr "From your own computer, open Remote Desktop (mstsc) and connect to"

msgid ""
"Từ máy của bạn, mở Remote Desktop (mstsc) và nối tới địa chỉ của "
"máy."
msgstr ""
"From your own computer, open Remote Desktop (mstsc) and connect to "
"the machine's address."

msgid "Địa chỉ để vào sau khi cài"
msgstr "Address to connect to after installing"

msgid "Quay lại trang này và bấm nút bên dưới để gỡ đĩa cài ra."
msgstr ""
"Come back to this page and press the button below to detach the "
"install media."

msgid "Tôi đã cài xong — gỡ đĩa cài"
msgstr "I have finished installing — detach the media"

msgid "Đã cài xong"
msgstr "Installed"

msgid ""
"Gỡ đĩa cài ra khỏi máy, và cho máy khởi động thẳng vào Windows. Bấm "
"nút này SAU KHI đã cài xong."
msgstr ""
"Detaches the install media and makes the machine boot straight into "
"Windows. Press this AFTER the install has finished."

msgid ""
"Cần cài lại sau này thì dùng nút “Cài lại máy” ở trang máy — nó gắn "
"đĩa cài trở lại."
msgstr ""
"If you need to reinstall later, use the “Reinstall” button on the "
"machine page — it attaches the install media again."

msgid "Ảnh chụp gần nhất"
msgstr "Latest snapshot"

msgid "Máy này chưa có ảnh chụp nào."
msgstr "This machine has no snapshot yet."

msgid ""
"Máy này chưa có ảnh chụp nào. Bản đầu tiên được chụp trong vòng một "
"tuần kể từ khi tạo máy."
msgstr ""
"This machine has no snapshot yet. The first one is taken within a "
"week of the machine being created."

msgid "chưa có — bản đầu tiên chụp trong vòng một tuần"
msgstr "none yet — the first is taken within a week"

msgid "Khôi phục"
msgstr "Restore"

msgid "Khôi phục về ảnh chụp"
msgstr "Restore to snapshot"

msgid ""
"Quay máy về bản chụp ngày %(ngay)s. Mọi thay đổi sau thời điểm đó sẽ "
"mất. Máy sẽ tắt."
msgstr ""
"Rolls the machine back to the snapshot from %(ngay)s. Everything "
"changed after that point is lost. The machine will be powered off."

msgid "Gõ đúng tên máy để xác nhận khôi phục."
msgstr "Type the machine name exactly to confirm the restore."

msgid "Nguy hiểm"
msgstr "Danger"

msgid "Cài lại"
msgstr "Reinstall"

msgid "Cài lại máy"
msgstr "Reinstall the machine"

msgid ""
"Xoá sạch đĩa và cài lại từ đầu. Địa chỉ IP được giữ nguyên. KHÔNG "
"hoàn tác được."
msgstr ""
"Wipes the disk and starts the install from scratch. The IP address "
"is kept. This CANNOT be undone."

msgid "Gõ đúng tên máy để xác nhận cài lại."
msgstr "Type the machine name exactly to confirm the reinstall."

msgid "Xoá máy"
msgstr "Delete machine"

msgid "Xoá vĩnh viễn"
msgstr "Delete permanently"

msgid ""
"Xoá vĩnh viễn máy và trả địa chỉ IP về. KHÔNG hoàn tác được và không "
"hoàn tiền chu kỳ đang dùng."
msgstr ""
"Permanently deletes the machine and returns the IP address. This "
"CANNOT be undone, and the current cycle is not refunded."

msgid "Gõ đúng tên máy để xác nhận xoá."
msgstr "Type the machine name exactly to confirm the deletion."

msgid "Gõ %(ten)s để xác nhận"
msgstr "Type %(ten)s to confirm"

msgid "Gõ: %(ten)s"
msgstr "Type: %(ten)s"

msgid ""
"Tắt máy dùng lệnh tắt mềm — hệ điều hành có thời gian dọn dẹp. Máy "
"đã tắt vẫn tính phí vì nó vẫn giữ chỗ và giữ dữ liệu."
msgstr ""
"Shuts the machine down gracefully, giving the operating system time "
"to tidy up. A stopped machine is still billed, because it still "
"holds its capacity and its data."

msgid "Sao kê thanh toán"
msgstr "Payment statement"

msgid "Đây là sao kê để bạn đối chiếu, không phải hoá đơn điện tử."
msgstr "This is a statement for your own reconciliation, not a tax invoice."

msgid "Tổng đã trả cho máy này: %(n)s credit."
msgstr "Total paid for this machine: %(n)s credit."

msgid "bản không ghi gì thêm"
msgstr "no further detail recorded"

msgid "Bấm \"Tạo máy\" là bạn đồng ý với"
msgstr "Pressing \"Create machine\" means you agree to the"

msgid ""
"Console dùng khi bạn không vào được bằng RDP — ví dụ vừa đổi tường "
"lửa hoặc cấu hình mạng trong máy. Nó chậm hơn RDP, đừng dùng để làm "
"việc hằng ngày."
msgstr ""
"The console is for when you cannot get in over RDP — for example "
"right after changing the firewall or the network settings inside the "
"machine. It is slower than RDP; do not use it for everyday work."

msgid "Đang kết nối…"
msgstr "Connecting…"

msgid "Đã kết nối. Bấm vào khung rồi gõ như trên máy thật."
msgstr ""
"Connected. Click inside the frame and type as you would on a real "
"machine."

msgid "Đã ngắt kết nối."
msgstr "Disconnected."

msgid "Kết nối lại"
msgstr "Reconnect"

msgid "Mất kết nối. Tải lại trang để mở console mới."
msgstr "Connection lost. Reload the page to open a new console."

msgid "Máy chủ từ chối phiên console. Tải lại trang để lấy vé mới."
msgstr ""
"The host refused the console session. Reload the page to get a fresh "
"ticket."

msgid "Bấm “Tạo máy” là bạn đồng ý với"
msgstr "Pressing “Create machine” means you agree to the"

msgid "Sao kê"
msgstr "Statement"

msgid "Ảnh chụp"
msgstr "Snapshots"

msgid "← Tất cả máy"
msgstr "← All machines"

msgid "Tắt máy"
msgstr "Stop"

msgid "Còn chỗ:"
msgstr "Available:"

msgid "Hết chỗ cho cấu hình này."
msgstr "No capacity left for this size."

msgid "So sánh ba gói"
msgstr "Compare the three plans"

msgid ""
"Cấu hình phần cứng và băng thông. Đổi được sau bằng cách tạo máy "
"khác."
msgstr "Hardware and bandwidth. To change it later, create another machine."

msgid ""
"Đĩa cài được gắn sẵn; bạn tự chạy trình cài đặt. Cài lại được bất cứ "
"lúc nào."
msgstr ""
"The install media is already attached; you run the installer "
"yourself. You can reinstall at any time."

