[
  {
    "start": 0.0,
    "end": 4.3,
    "text": "The human brain can survive hunger for days.",
    "type": "speech",
    "scene_id": "S0001",
    "index": 1
  },
  {
    "start": 4.3,
    "end": 8.36,
    "text": "It can survive sleep loss.",
    "type": "speech",
    "scene_id": "S0002",
    "index": 2
  },
  {
    "start": 8.36,
    "end": 11.8,
    "text": "It can survive pain.",
    "type": "speech",
    "scene_id": "S0003",
    "index": 3
  },
  {
    "start": 11.8,
    "end": 15.86,
    "text": "But let one person look at you the wrong way,",
    "type": "speech",
    "scene_id": "S0004",
    "index": 4
  },
  {
    "start": 15.86,
    "end": 21.58,
    "text": "and suddenly your whole inner world can collapse.",
    "type": "speech",
    "scene_id": "S0005",
    "index": 5
  },
  {
    "start": 21.58,
    "end": 24.44,
    "text": "A pause feels longer.",
    "type": "speech",
    "scene_id": "S0006",
    "index": 6
  },
  {
    "start": 24.44,
    "end": 27.82,
    "text": "A sentence feels colder.",
    "type": "speech",
    "scene_id": "S0007",
    "index": 7
  },
  {
    "start": 27.82,
    "end": 30.94,
    "text": "A small mistake feels enormous,",
    "type": "speech",
    "scene_id": "S0008",
    "index": 8
  },
  {
    "start": 30.94,
    "end": 35.98,
    "text": "and a single no can follow you for the rest of the day.",
    "type": "speech",
    "scene_id": "S0009",
    "index": 9
  },
  {
    "start": 35.98,
    "end": 41.04,
    "text": "That is what makes the fear of rejection so strange.",
    "type": "speech",
    "scene_id": "S0010",
    "index": 10
  },
  {
    "start": 41.04,
    "end": 45.56,
    "text": "It is not loud.",
    "type": "speech",
    "scene_id": "S0011",
    "index": 11
  },
  {
    "start": 45.56,
    "end": 48.82,
    "text": "It is not dramatic.",
    "type": "speech",
    "scene_id": "S0012",
    "index": 12
  },
  {
    "start": 48.82,
    "end": 52.3,
    "text": "It is not always visible.",
    "type": "speech",
    "scene_id": "S0013",
    "index": 13
  },
  {
    "start": 52.3,
    "end": 57.98,
    "text": "But for the brain it can feel like something very serious has happened.",
    "type": "speech",
    "scene_id": "S0014",
    "index": 14
  }
]