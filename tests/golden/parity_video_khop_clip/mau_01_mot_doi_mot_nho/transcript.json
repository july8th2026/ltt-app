[
  {
    "start": 0.0,
    "end": 4.68,
    "text": "Bài học giác ngộ về chữ buông Bế bổng một cô gái tuyệt đẹp qua",
    "type": "speech",
    "scene_id": "S0001",
    "index": 1
  },
  {
    "start": 4.68,
    "end": 8.16,
    "text": "vũng buồn lầy Vị thiền sư bị đệ tử trách móc,",
    "type": "speech",
    "scene_id": "S0002",
    "index": 2
  },
  {
    "start": 8.16,
    "end": 12.86,
    "text": "gây gắt vì phạm giới Nhưng câu đáp trả điềm nhiên Ta đã đặt",
    "type": "speech",
    "scene_id": "S0003",
    "index": 3
  },
  {
    "start": 12.86,
    "end": 17.16,
    "text": "nàng xuống từ lâu, sao đệ vẫn còn bé Đã vạch trần",
    "type": "speech",
    "scene_id": "S0004",
    "index": 4
  },
  {
    "start": 17.16,
    "end": 21.94,
    "text": "một bí mật chấn động về tâm trí Có hai nhà sư cùng thong",
    "type": "speech",
    "scene_id": "S0005",
    "index": 5
  },
  {
    "start": 21.94,
    "end": 26.44,
    "text": "giong bước xuống một con đường lầy Cơn mưa nặng hạt vẫn còn rơi,",
    "type": "speech",
    "scene_id": "S0006",
    "index": 6
  },
  {
    "start": 26.44,
    "end": 31.12,
    "text": "đến khúc đường quẹo Hai người gặp một cô gái xinh xánh trong chiếc",
    "type": "speech",
    "scene_id": "S0007",
    "index": 7
  },
  {
    "start": 31.12,
    "end": 35.46,
    "text": "áo kimu và chiếc khanh quàng cổ bằng lũa đang đứng bên",
    "type": "speech",
    "scene_id": "S0008",
    "index": 8
  },
  {
    "start": 35.46,
    "end": 39.92,
    "text": "lề đường vì không thể băng qua đường lề được. Lập tức một nhà",
    "type": "speech",
    "scene_id": "S0009",
    "index": 9
  },
  {
    "start": 39.92,
    "end": 44.08,
    "text": "sư bảo đi nào, cô bé tức khắc đưa tay nhấc bỗng cô gái lên",
    "type": "speech",
    "scene_id": "S0010",
    "index": 10
  },
  {
    "start": 44.08,
    "end": 46.34,
    "text": "và đưa qua quảng đường lề.",
    "type": "speech",
    "scene_id": "S0011",
    "index": 11
  },
  {
    "start": 46.34,
    "end": 50.86,
    "text": "Nhà sư bạn của anh ta từ đó không buồn nói một tiếng nào",
    "type": "speech",
    "scene_id": "S0012",
    "index": 12
  },
  {
    "start": 50.86,
    "end": 55.48,
    "text": "Cho đến khi cả hai dừng lại trong một ngôi đền Rồi không chịu",
    "type": "speech",
    "scene_id": "S0013",
    "index": 13
  },
  {
    "start": 55.48,
    "end": 59.36,
    "text": "được nữa Nhà sư bạn lên tiếng nói với anh ta Ở chúng",
    "type": "speech",
    "scene_id": "S0014",
    "index": 14
  },
  {
    "start": 59.36,
    "end": 63.64,
    "text": "ta là những nhà sư không được phép gần đàn bà Nhất",
    "type": "speech",
    "scene_id": "S0015",
    "index": 15
  },
  {
    "start": 63.64,
    "end": 68.22,
    "text": "là những người đàn bà trẻ đẹp Nguy hiểm lắm Sao anh lại làm",
    "type": "speech",
    "scene_id": "S0016",
    "index": 16
  },
  {
    "start": 68.22,
    "end": 72.64,
    "text": "vậy? Nhà sư mỉm cười Tôi đã bỏ nàng từ chỗ đó rồi",
    "type": "speech",
    "scene_id": "S0017",
    "index": 17
  },
  {
    "start": 72.64,
    "end": 75.54,
    "text": "Anh còn mang nàng theo đấy sao?",
    "type": "speech",
    "scene_id": "S0018",
    "index": 18
  },
  {
    "start": 75.54,
    "end": 79.56,
    "text": "Quá khứ đã đặt xuống, cỡ sao tâm trí còn mãi giam cầm",
    "type": "speech",
    "scene_id": "S0019",
    "index": 19
  },
  {
    "start": 79.56,
    "end": 83.5,
    "text": "Hình hài không vướng bận, nhưng tâm niệm dính mắt mới",
    "type": "speech",
    "scene_id": "S0020",
    "index": 20
  },
  {
    "start": 83.5,
    "end": 88.3,
    "text": "là chiếc lồng giam kiên cố nhất Buông được, ít thanh thang",
    "type": "speech",
    "scene_id": "S0021",
    "index": 21
  }
]