[
  {
    "start": 0.0,
    "end": 4.52,
    "text": "Bị ép gã cho kẻ ăn mày, quả báo hay phép màu nhân quả",
    "type": "speech",
    "scene_id": "S0001",
    "index": 1
  },
  {
    "start": 4.52,
    "end": 8.92,
    "text": "Chỉ vì tin vào luật nhân quả, nàng công chúa bị vua cha giận giữ",
    "type": "speech",
    "scene_id": "S0002",
    "index": 2
  },
  {
    "start": 8.92,
    "end": 13.56,
    "text": "ép gã cho kẻ ăn mày rách rưới Nhưng ba lưu vàng trôn dấu",
    "type": "speech",
    "scene_id": "S0003",
    "index": 3
  },
  {
    "start": 13.56,
    "end": 18.48,
    "text": "dưới túp lèo hoang đã hé lộ một bí mật tiền kiếp chấn động trốn hoàng",
    "type": "speech",
    "scene_id": "S0004",
    "index": 4
  },
  {
    "start": 18.48,
    "end": 23.2,
    "text": "cung Công chúa Nhật Quang là con thứ hai của vua Ba Tư nặt",
    "type": "speech",
    "scene_id": "S0005",
    "index": 5
  },
  {
    "start": 23.2,
    "end": 25.88,
    "text": "nước xá vệ Công chúa rất đẹp,",
    "type": "speech",
    "scene_id": "S0006",
    "index": 6
  },
  {
    "start": 25.88,
    "end": 30.12,
    "text": "một vẻ đẹp thùy mị hơn hẳn các thiếu nữ đương thời ở nước",
    "type": "speech",
    "scene_id": "S0007",
    "index": 7
  },
  {
    "start": 30.12,
    "end": 34.32,
    "text": "xá vệ Công chúa lại rất thông minh học đâu nhớ đấy Không",
    "type": "speech",
    "scene_id": "S0008",
    "index": 8
  },
  {
    "start": 34.32,
    "end": 38.7,
    "text": "những công chúa sắc xảo về môn nữ công mà còn tin thông",
    "type": "speech",
    "scene_id": "S0009",
    "index": 9
  },
  {
    "start": 38.7,
    "end": 43.64,
    "text": "các triết lý học thuật đức hạnh công chúa cũng quán chúng Tuy sanh trong giai cấp",
    "type": "speech",
    "scene_id": "S0010",
    "index": 10
  },
  {
    "start": 43.64,
    "end": 47.86,
    "text": "vua chúa cao sang nhưng vẫn giữ thái độ khiêm tốn nhã nhặn",
    "type": "speech",
    "scene_id": "S0011",
    "index": 11
  },
  {
    "start": 47.86,
    "end": 52.58,
    "text": "Nhất là đối với hạng nghèo khổ tật nguyện Công chúa thành thật yêu",
    "type": "speech",
    "scene_id": "S0012",
    "index": 12
  },
  {
    "start": 52.58,
    "end": 55.14,
    "text": "mến và luôn luôn tìm cách giúp đỡ.",
    "type": "speech",
    "scene_id": "S0013",
    "index": 13
  },
  {
    "start": 55.14,
    "end": 59.24,
    "text": "Vì thế nên công chúa được rất nhiều người kính trọng.",
    "type": "speech",
    "scene_id": "S0014",
    "index": 14
  },
  {
    "start": 59.24,
    "end": 62.52,
    "text": "Người nào đã hân hạnh gặp công chúa một lần,",
    "type": "speech",
    "scene_id": "S0015",
    "index": 15
  },
  {
    "start": 62.52,
    "end": 67.04,
    "text": "họ sẽ nhớ mãi nụ cười hiền hòa và lời nói thanh tao của công",
    "type": "speech",
    "scene_id": "S0016",
    "index": 16
  },
  {
    "start": 67.04,
    "end": 71.52,
    "text": "chúa. Đối với cha mẹ, công chúa thật là người con hiếu hạnh,",
    "type": "speech",
    "scene_id": "S0017",
    "index": 17
  },
  {
    "start": 71.52,
    "end": 74.98,
    "text": "nàng hầu hạ vua và hoàng hậu hết sức chú đáo,",
    "type": "speech",
    "scene_id": "S0018",
    "index": 18
  },
  {
    "start": 74.98,
    "end": 79.62,
    "text": "và không bao giờ nói một lời hay là một việc trái ý vua và hoàng",
    "type": "speech",
    "scene_id": "S0019",
    "index": 19
  },
  {
    "start": 79.62,
    "end": 83.94,
    "text": "hậu. Ba tư nạc vương được một người con xứng đáng như vậy,",
    "type": "speech",
    "scene_id": "S0020",
    "index": 20
  },
  {
    "start": 83.94,
    "end": 87.76,
    "text": "vua rất cưng quý, có thể nói công chúa Nhật Quang",
    "type": "speech",
    "scene_id": "S0021",
    "index": 21
  },
  {
    "start": 87.76,
    "end": 90.8,
    "text": "là viên ngọc vô giá của vua nước xá vệ.",
    "type": "speech",
    "scene_id": "S0022",
    "index": 22
  },
  {
    "start": 90.8,
    "end": 93.88,
    "text": "Những cuộc quan sơn ngoạn thủy của vua,",
    "type": "speech",
    "scene_id": "S0023",
    "index": 23
  },
  {
    "start": 93.88,
    "end": 98.02,
    "text": "công chúa đều được tham dự Mỗi khi quốc sự rảnh ràng,",
    "type": "speech",
    "scene_id": "S0024",
    "index": 24
  },
  {
    "start": 98.02,
    "end": 102.4,
    "text": "nhà vua thường đòi công chúa đến hầu chuyện Hỏi những vấn",
    "type": "speech",
    "scene_id": "S0025",
    "index": 25
  },
  {
    "start": 102.4,
    "end": 106.76,
    "text": "đề thắc mắc công chúa đều trả lời trôi chảy Nhà vua rất đẹp",
    "type": "speech",
    "scene_id": "S0026",
    "index": 26
  },
  {
    "start": 106.76,
    "end": 111.06,
    "text": "dạ Một buổi chiều nhà vua đang dùng trà tại vườn ngựa",
    "type": "speech",
    "scene_id": "S0027",
    "index": 27
  },
  {
    "start": 111.06,
    "end": 115.86,
    "text": "uyển Có công chúa đứng bên cạnh Nhà vua nhìn con rồi vui miệng phán",
    "type": "speech",
    "scene_id": "S0028",
    "index": 28
  },
  {
    "start": 115.86,
    "end": 120.0,
    "text": "rằng Khắp nước xá vệ này không ai được hạnh phúc bằng con",
    "type": "speech",
    "scene_id": "S0029",
    "index": 29
  },
  {
    "start": 120.0,
    "end": 124.28,
    "text": "đời con được như thế thật là hoàn toàn nhờ sức của cha",
    "type": "speech",
    "scene_id": "S0030",
    "index": 30
  },
  {
    "start": 124.28,
    "end": 128.98,
    "text": "mẹ tác thành vậy công chúa nhật quan thành thật trả lời tâu",
    "type": "speech",
    "scene_id": "S0031",
    "index": 31
  },
  {
    "start": 128.98,
    "end": 133.16,
    "text": "phụ vương công ơn sanh dưỡng của phụ hoàng và mẫu hậu",
    "type": "speech",
    "scene_id": "S0032",
    "index": 32
  },
  {
    "start": 133.16,
    "end": 137.84,
    "text": "như trời bể con không hề dám quên nhưng đời con được hạnh phúc",
    "type": "speech",
    "scene_id": "S0033",
    "index": 33
  },
  {
    "start": 137.84,
    "end": 142.52,
    "text": "như thế này con thiết tượng cũng có ảnh hưởng của cha mẹ một phần nào",
    "type": "speech",
    "scene_id": "S0034",
    "index": 34
  },
  {
    "start": 142.52,
    "end": 147.16,
    "text": "nhưng phần lớn nhờ kiếp trước con đã tu nhân tích đức nhiều",
    "type": "speech",
    "scene_id": "S0035",
    "index": 35
  },
  {
    "start": 147.16,
    "end": 150.68,
    "text": "vậy câu nói của công chúa không ngờ đã chạm lòng",
    "type": "speech",
    "scene_id": "S0036",
    "index": 36
  },
  {
    "start": 150.68,
    "end": 155.52,
    "text": "tự ái của vua ba tư nặc quá mạnh vua liền đứng dậy lặng",
    "type": "speech",
    "scene_id": "S0037",
    "index": 37
  },
  {
    "start": 155.52,
    "end": 159.86,
    "text": "lẽ trở vào cung đêm hôm ấy nhà vua không hề chập mắt",
    "type": "speech",
    "scene_id": "S0038",
    "index": 38
  },
  {
    "start": 159.86,
    "end": 164.34,
    "text": "suy nghĩ mãi lời nói của công chúa và vua rất bực tức đứa con",
    "type": "speech",
    "scene_id": "S0039",
    "index": 39
  },
  {
    "start": 164.34,
    "end": 167.72,
    "text": "yêu và ngoan ngoãn của mình chưa bao giờ trái ý mình",
    "type": "speech",
    "scene_id": "S0040",
    "index": 40
  },
  {
    "start": 167.72,
    "end": 172.14,
    "text": "dù là một cử chỉ nhỏ nhặt hôm nay lại xúc xúc phạm đến lòng",
    "type": "speech",
    "scene_id": "S0041",
    "index": 41
  },
  {
    "start": 172.14,
    "end": 176.3,
    "text": "tự ái của mình, có thể nói là không thừa nhận một lý thuyết,",
    "type": "speech",
    "scene_id": "S0042",
    "index": 42
  },
  {
    "start": 176.3,
    "end": 180.62,
    "text": "à nghĩa là hạnh phúc của con hoàn toàn do cha mẹ tác thà nhở,",
    "type": "speech",
    "scene_id": "S0043",
    "index": 43
  },
  {
    "start": 180.62,
    "end": 184.7,
    "text": "mà ông cho là muôn đời bất biến, và ai cũng phải công nhận.",
    "type": "speech",
    "scene_id": "S0044",
    "index": 44
  },
  {
    "start": 184.7,
    "end": 188.82,
    "text": "Muốn bảo thủ thành kiến của mình, nên mới sáng tinh sương,",
    "type": "speech",
    "scene_id": "S0045",
    "index": 45
  },
  {
    "start": 188.82,
    "end": 192.86,
    "text": "ba tư nạc vương liền đòi viên cận thần thân tính bảo rằng,",
    "type": "speech",
    "scene_id": "S0046",
    "index": 46
  },
  {
    "start": 192.86,
    "end": 196.6,
    "text": "ta cần một thanh niên trạt tuổi công chúa nhật quang,",
    "type": "speech",
    "scene_id": "S0047",
    "index": 47
  },
  {
    "start": 196.6,
    "end": 201.26,
    "text": "mà hiện sống trong một cảnh nghèo hèn, cơm không có ăn áo không",
    "type": "speech",
    "scene_id": "S0048",
    "index": 48
  },
  {
    "start": 201.26,
    "end": 206.26,
    "text": "đủ mặt người phải tìm cho ra một người có đủ điều kiện ấy dẫn",
    "type": "speech",
    "scene_id": "S0049",
    "index": 49
  },
  {
    "start": 206.26,
    "end": 210.74,
    "text": "về đây cho ta ba ngày sau viên cận thần dẫn về một thanh",
    "type": "speech",
    "scene_id": "S0050",
    "index": 50
  },
  {
    "start": 210.74,
    "end": 215.22,
    "text": "niên hành khất mặc mũi khôi ngô nhưng trong người chỉ mặc võn",
    "type": "speech",
    "scene_id": "S0051",
    "index": 51
  },
  {
    "start": 215.22,
    "end": 219.98,
    "text": "vẹn một chiếc khố rách đến ý kiến vua ba tư nặc vua rất mừng ban",
    "type": "speech",
    "scene_id": "S0052",
    "index": 52
  },
  {
    "start": 219.98,
    "end": 224.3,
    "text": "thưởng viên cận thần xong quay lại hỏi thân thế thanh niên hành khất",
    "type": "speech",
    "scene_id": "S0053",
    "index": 53
  },
  {
    "start": 224.3,
    "end": 228.68,
    "text": "rồi bảo rằng ta thấy người nghèo khổ Chưa có gia thất,",
    "type": "speech",
    "scene_id": "S0054",
    "index": 54
  },
  {
    "start": 228.68,
    "end": 231.8,
    "text": "nay ta đem công chúa Nhật Quang gã cho ngươi,",
    "type": "speech",
    "scene_id": "S0055",
    "index": 55
  },
  {
    "start": 231.8,
    "end": 235.4,
    "text": "ngươi được quyền dẫn công chúa đi đâu tùy ngươi.",
    "type": "speech",
    "scene_id": "S0056",
    "index": 56
  },
  {
    "start": 235.4,
    "end": 239.76,
    "text": "Thành niên nghèo khổ kia không biết trả lời ra sao chỉ cuối đầu",
    "type": "speech",
    "scene_id": "S0057",
    "index": 57
  },
  {
    "start": 239.76,
    "end": 244.34,
    "text": "vân lệnh. Vua lại kêu công chúa Nhật Quang đến phán rằng hôm",
    "type": "speech",
    "scene_id": "S0058",
    "index": 58
  },
  {
    "start": 244.34,
    "end": 248.84,
    "text": "kia con đã nói hạnh phúc của con hiện tại phần lớn là do con",
    "type": "speech",
    "scene_id": "S0059",
    "index": 59
  },
  {
    "start": 248.84,
    "end": 253.48,
    "text": "đã tu nhân tích đức ngày trước. Này ta muốn thí nghiệm lời ấy,",
    "type": "speech",
    "scene_id": "S0060",
    "index": 60
  },
  {
    "start": 253.48,
    "end": 256.56,
    "text": "nên ta đã gã con cho một thanh niên hành khất.",
    "type": "speech",
    "scene_id": "S0061",
    "index": 61
  },
  {
    "start": 256.56,
    "end": 261.0,
    "text": "Nếu con có phước báo thì con cũng trở nên giàu có sung sướng.",
    "type": "speech",
    "scene_id": "S0062",
    "index": 62
  },
  {
    "start": 261.0,
    "end": 264.78,
    "text": "Con hãy sửa soạn ngày mai lên đường với chồng con,",
    "type": "speech",
    "scene_id": "S0063",
    "index": 63
  },
  {
    "start": 264.78,
    "end": 267.68,
    "text": "khi nào có chiếu chỉ mới được trở về cung.",
    "type": "speech",
    "scene_id": "S0064",
    "index": 64
  },
  {
    "start": 267.68,
    "end": 271.68,
    "text": "Với nét mặt đầy nghiêm nghị của vua ba tư nạc vương,",
    "type": "speech",
    "scene_id": "S0065",
    "index": 65
  },
  {
    "start": 271.68,
    "end": 275.84,
    "text": "công chúa không dám nói gì, chỉ yên lặng trở về hậu cung",
    "type": "speech",
    "scene_id": "S0066",
    "index": 66
  },
  {
    "start": 275.84,
    "end": 280.1,
    "text": "Sáng ngày công chúa vào lại cha mẹ, từ biệt mọi người,",
    "type": "speech",
    "scene_id": "S0067",
    "index": 67
  },
  {
    "start": 280.1,
    "end": 284.64,
    "text": "rồi bình tĩnh ra đi với thanh niên hành khất Hoàng hậu và thần",
    "type": "speech",
    "scene_id": "S0068",
    "index": 68
  },
  {
    "start": 284.64,
    "end": 288.84,
    "text": "dân đều thương xót và khóc lóc, lo ngại cho số phận công chúa",
    "type": "speech",
    "scene_id": "S0069",
    "index": 69
  },
  {
    "start": 288.84,
    "end": 293.58,
    "text": "Nhưng ý vua đã quyết nào ai dám mở lời khuyên can ra khỏi",
    "type": "speech",
    "scene_id": "S0070",
    "index": 70
  },
  {
    "start": 293.58,
    "end": 299.52,
    "text": "hoàng cung Công chúa hỏi thanh niên hành khất rằng Cha mẹ chàng đâu? Nhà cửa chàng đâu?",
    "type": "speech",
    "scene_id": "S0071",
    "index": 71
  },
  {
    "start": 299.52,
    "end": 302.4,
    "text": "Vì sao chàng lại nghèo khổ đến thế?",
    "type": "speech",
    "scene_id": "S0072",
    "index": 72
  },
  {
    "start": 302.4,
    "end": 305.82,
    "text": "Thanh niên buồn rầu đáp Gia đình tôi trước cũng giàu",
    "type": "speech",
    "scene_id": "S0073",
    "index": 73
  },
  {
    "start": 305.82,
    "end": 310.32,
    "text": "có Vì được cha mẹ cưng quý Tôi tiêu xài hoang phí Ham",
    "type": "speech",
    "scene_id": "S0074",
    "index": 74
  },
  {
    "start": 310.32,
    "end": 314.1,
    "text": "chơi bời với chúng bạn Có học tập nhưng không đâu đạt",
    "type": "speech",
    "scene_id": "S0075",
    "index": 75
  },
  {
    "start": 314.1,
    "end": 318.86,
    "text": "gì Đến khi cha mẹ qua đời Tôi bán hết ruộng đất nhà cửa",
    "type": "speech",
    "scene_id": "S0076",
    "index": 76
  },
  {
    "start": 318.86,
    "end": 323.4,
    "text": "Hiện nay chỉ còn một sở vườn Cách đê trăm dặm cỏ lát mọc",
    "type": "speech",
    "scene_id": "S0077",
    "index": 77
  },
  {
    "start": 323.4,
    "end": 327.82,
    "text": "đầy cho người ta mướn họ không mướn, bán họ không thèm mua,",
    "type": "speech",
    "scene_id": "S0078",
    "index": 78
  },
  {
    "start": 327.82,
    "end": 332.0,
    "text": "hết của cãi, không nghề nghiệp, không biết nghề gì nuôi thân,",
    "type": "speech",
    "scene_id": "S0079",
    "index": 79
  },
  {
    "start": 332.0,
    "end": 336.56,
    "text": "nên phải hành khất độ nhật. Hôm nay tôi đang lang thang giữa đường,",
    "type": "speech",
    "scene_id": "S0080",
    "index": 80
  },
  {
    "start": 336.56,
    "end": 341.02,
    "text": "thì gặp một vị quan của vua, ông ta hỏi cặn kẻ về gia thế",
    "type": "speech",
    "scene_id": "S0081",
    "index": 81
  },
  {
    "start": 341.02,
    "end": 343.9,
    "text": "tôi, rồi ông dẫn tôi ý kiến nhà vua,",
    "type": "speech",
    "scene_id": "S0082",
    "index": 82
  },
  {
    "start": 343.9,
    "end": 349.74,
    "text": "không biết gì sao nhà vua lại đem công chúa gã cho một kẻ nghèo hèn như tôi.",
    "type": "speech",
    "scene_id": "S0083",
    "index": 83
  },
  {
    "start": 349.74,
    "end": 354.14,
    "text": "Vẫn nét mặt ôn hòa công chúa nói với thanh niên hành khất rằng",
    "type": "speech",
    "scene_id": "S0084",
    "index": 84
  },
  {
    "start": 354.14,
    "end": 358.68,
    "text": "Dù sao từ nay chúng ta cũng đã là vợ chồng Chúng ta phải tìm",
    "type": "speech",
    "scene_id": "S0085",
    "index": 85
  },
  {
    "start": 358.68,
    "end": 363.54,
    "text": "phương kế làm ăn và trước hết phải tìm nơi tạm trú Không biết",
    "type": "speech",
    "scene_id": "S0086",
    "index": 86
  },
  {
    "start": 363.54,
    "end": 367.88,
    "text": "tìm chỗ nào khác Nên công chúa và thanh niên hành khất liền dẫn",
    "type": "speech",
    "scene_id": "S0087",
    "index": 87
  },
  {
    "start": 367.88,
    "end": 371.94,
    "text": "nhau đến sở vườn của cha mẹ thanh niên Để lại ở thật",
    "type": "speech",
    "scene_id": "S0088",
    "index": 88
  },
  {
    "start": 371.94,
    "end": 376.7,
    "text": "là một mảnh vườn hoang phế Có lát um tùm sỏi đã lỡm chẩm Hai",
    "type": "speech",
    "scene_id": "S0089",
    "index": 89
  },
  {
    "start": 376.7,
    "end": 381.1,
    "text": "người bàn đỉnh cắt cỏ đốn cây che một chiếc tròi nhỏ vừa tạm",
    "type": "speech",
    "scene_id": "S0090",
    "index": 90
  },
  {
    "start": 381.1,
    "end": 385.74,
    "text": "ở Những người quanh đấy có người biết công chúa nhật quan nên cùng",
    "type": "speech",
    "scene_id": "S0091",
    "index": 91
  },
  {
    "start": 385.74,
    "end": 390.4,
    "text": "nhau đến giúp đỡ công việc cho công chúa Đến khi đào đất",
    "type": "speech",
    "scene_id": "S0092",
    "index": 92
  },
  {
    "start": 390.4,
    "end": 394.64,
    "text": "để dựng cột nhà Vừa đào được vài lát đất thì gặp ngay",
    "type": "speech",
    "scene_id": "S0093",
    "index": 93
  },
  {
    "start": 394.64,
    "end": 398.68,
    "text": "ba cái chôm lớn niêm khần cẩn thận Công chúa liền mở chôm",
    "type": "speech",
    "scene_id": "S0094",
    "index": 94
  },
  {
    "start": 398.68,
    "end": 403.14,
    "text": "ra thì thấy trong ba cái chôm ấy vô số là vàng bạc châu báu",
    "type": "speech",
    "scene_id": "S0095",
    "index": 95
  },
  {
    "start": 403.14,
    "end": 407.58,
    "text": "Công chúa vui mừng sung sướng, đem bán bớt một số châu báo,",
    "type": "speech",
    "scene_id": "S0096",
    "index": 96
  },
  {
    "start": 407.58,
    "end": 411.8,
    "text": "rồi chính mướn ngừa chính dọn dẹp cỏ rác, trồng tỉa hoa quả,",
    "type": "speech",
    "scene_id": "S0097",
    "index": 97
  },
  {
    "start": 411.8,
    "end": 415.44,
    "text": "tạo lập lâu đài. Vốn sẵn tánh hiền lành lạ,",
    "type": "speech",
    "scene_id": "S0098",
    "index": 98
  },
  {
    "start": 415.44,
    "end": 418.44,
    "text": "chính sẵn lòng yêu thương giúp đỡ mọi người,",
    "type": "speech",
    "scene_id": "S0099",
    "index": 99
  },
  {
    "start": 418.44,
    "end": 421.6,
    "text": "nên thợ thuyền tôi tớ rất trung thành tận tụy.",
    "type": "speech",
    "scene_id": "S0100",
    "index": 100
  },
  {
    "start": 421.6,
    "end": 425.96,
    "text": "Không bao lâu đám vườn hoang phế kia đã biến thành một vườn",
    "type": "speech",
    "scene_id": "S0101",
    "index": 101
  },
  {
    "start": 425.96,
    "end": 429.38,
    "text": "hoa trăm sắc muôn màu lâu đại trang hoàng lộng lẫy,",
    "type": "speech",
    "scene_id": "S0102",
    "index": 102
  },
  {
    "start": 429.38,
    "end": 433.94,
    "text": "người vô kẻ ra tấp nập, không khác dinh thự của Bậc Đế Vương.",
    "type": "speech",
    "scene_id": "S0103",
    "index": 103
  },
  {
    "start": 433.94,
    "end": 438.56,
    "text": "Từ khi công chúa rời khỏi cung điện, vua Ba Tư nặt sanh lòng hối",
    "type": "speech",
    "scene_id": "S0104",
    "index": 104
  },
  {
    "start": 438.56,
    "end": 443.18,
    "text": "hận đêm ngày trong nhớ. Nhà vua đinh ninh rằng công chúa lâu nay chắc",
    "type": "speech",
    "scene_id": "S0105",
    "index": 105
  },
  {
    "start": 443.18,
    "end": 446.96,
    "text": "gặp nhiều khổ sở và định đón công chúa trở về cung",
    "type": "speech",
    "scene_id": "S0106",
    "index": 106
  },
  {
    "start": 446.96,
    "end": 449.7,
    "text": "để an hưởng cảnh đoàn viên phú quý.",
    "type": "speech",
    "scene_id": "S0107",
    "index": 107
  },
  {
    "start": 449.7,
    "end": 453.56,
    "text": "Nhà vua liền phái một số cận thần tìm nơi công chúa,",
    "type": "speech",
    "scene_id": "S0108",
    "index": 108
  },
  {
    "start": 453.56,
    "end": 457.46,
    "text": "ở và dò xem đời sống của công chúa ra sao.",
    "type": "speech",
    "scene_id": "S0109",
    "index": 109
  },
  {
    "start": 457.46,
    "end": 461.72,
    "text": "Sau một thời gian dò xét, các cận thần về tâu với nhà vua.",
    "type": "speech",
    "scene_id": "S0110",
    "index": 110
  },
  {
    "start": 461.72,
    "end": 465.8,
    "text": "Công chúa ở cách xa cung điện nhà vua chừng 300 dặm",
    "type": "speech",
    "scene_id": "S0111",
    "index": 111
  },
  {
    "start": 465.8,
    "end": 470.5,
    "text": "và hiện đang ở trong cảnh phong lưu sung sướng dầu có ức triệu.",
    "type": "speech",
    "scene_id": "S0112",
    "index": 112
  },
  {
    "start": 470.5,
    "end": 474.44,
    "text": "Vua Ba Tư Nặc không tin, liền đến nơi dò xét quả đúng",
    "type": "speech",
    "scene_id": "S0113",
    "index": 113
  },
  {
    "start": 474.44,
    "end": 478.96,
    "text": "như lời các cận thần. Nhà vua nói với kẻ tả hữu rằng Trẩm thấy",
    "type": "speech",
    "scene_id": "S0114",
    "index": 114
  },
  {
    "start": 478.96,
    "end": 483.6,
    "text": "đời sống của vợ chồng công chúa Nhật quan hiện tại Tuy Trẩm",
    "type": "speech",
    "scene_id": "S0115",
    "index": 115
  },
  {
    "start": 483.6,
    "end": 487.18,
    "text": "là vua một nước Thật cũng không sung sướng bằng",
    "type": "speech",
    "scene_id": "S0116",
    "index": 116
  },
  {
    "start": 487.18,
    "end": 491.32,
    "text": "Nhưng vua cũng băng khoan thắc mắc Không biết tiền kiếp công",
    "type": "speech",
    "scene_id": "S0117",
    "index": 117
  },
  {
    "start": 491.32,
    "end": 495.52,
    "text": "chúa đã tu những nhân lành gì mà nay được nhiều phước báo",
    "type": "speech",
    "scene_id": "S0118",
    "index": 118
  },
  {
    "start": 495.52,
    "end": 499.78,
    "text": "như vậy Vốn nghe Đức Phật thích Cà Mâu Ni là Bậc Đại Giác",
    "type": "speech",
    "scene_id": "S0119",
    "index": 119
  },
  {
    "start": 499.78,
    "end": 504.6,
    "text": "Nên vua thân hành đến tỉnh xá nơi Phật thuyết pháp Cung kính bạch",
    "type": "speech",
    "scene_id": "S0120",
    "index": 120
  },
  {
    "start": 504.6,
    "end": 509.18,
    "text": "rằng, bạch thế tôn, nghe danh Ngài là bậc đại giác chứng",
    "type": "speech",
    "scene_id": "S0121",
    "index": 121
  },
  {
    "start": 509.18,
    "end": 512.14,
    "text": "nhất thế trí, hiểu thấu việc trong ba đời.",
    "type": "speech",
    "scene_id": "S0122",
    "index": 122
  },
  {
    "start": 512.14,
    "end": 515.12,
    "text": "Nay đệ tử có điều nghi xin Ngài chỉ dạy.",
    "type": "speech",
    "scene_id": "S0123",
    "index": 123
  },
  {
    "start": 515.12,
    "end": 518.06,
    "text": "Nhật quan công chúa thứ hai của đệ tử,",
    "type": "speech",
    "scene_id": "S0124",
    "index": 124
  },
  {
    "start": 518.06,
    "end": 522.48,
    "text": "không biết đời trước tạo nhân lành gì, mà ngày nay tướng mạo",
    "type": "speech",
    "scene_id": "S0125",
    "index": 125
  },
  {
    "start": 522.48,
    "end": 525.78,
    "text": "đẹp đẻ, thông minh xuất chúng, giàu có sang trọng.",
    "type": "speech",
    "scene_id": "S0126",
    "index": 126
  },
  {
    "start": 525.78,
    "end": 530.46,
    "text": "Đệ tử đã gã công chúa cho một kẻ hành khất nghèo hèn thế",
    "type": "speech",
    "scene_id": "S0127",
    "index": 127
  },
  {
    "start": 530.46,
    "end": 534.94,
    "text": "Mà công chúa cũng đào được vàng bạc rồi trở nên sang trọng hơn",
    "type": "speech",
    "scene_id": "S0128",
    "index": 128
  },
  {
    "start": 534.94,
    "end": 539.1,
    "text": "người Đệ tử cứ thắc mắc mãi mong ngài từ bi khai thị",
    "type": "speech",
    "scene_id": "S0129",
    "index": 129
  },
  {
    "start": 539.1,
    "end": 543.3,
    "text": "cho đệ tử rõ Đức Phật thích ca nở nụ cười hiền hòa,",
    "type": "speech",
    "scene_id": "S0130",
    "index": 130
  },
  {
    "start": 543.3,
    "end": 548.56,
    "text": "muôn thủa thông thả dạy rằng Nghi vấn đại vương sẽ được tiêu tan sau khi nghe câu",
    "type": "speech",
    "scene_id": "S0131",
    "index": 131
  },
  {
    "start": 548.56,
    "end": 553.24,
    "text": "chuyện này Ở nầy đại vương, xưa kia khi Đức Phật ca díp",
    "type": "speech",
    "scene_id": "S0132",
    "index": 132
  },
  {
    "start": 553.24,
    "end": 557.08,
    "text": "ra đời Có hai vợ chồng người lái buôn giàu có, người",
    "type": "speech",
    "scene_id": "S0133",
    "index": 133
  },
  {
    "start": 557.08,
    "end": 561.32,
    "text": "vợ rất tôn kính tam bảo, thường khuyến khích mọi người",
    "type": "speech",
    "scene_id": "S0134",
    "index": 134
  },
  {
    "start": 561.32,
    "end": 564.24,
    "text": "bỏ việc ác làm lành. Quy y tam bảo,",
    "type": "speech",
    "scene_id": "S0135",
    "index": 135
  },
  {
    "start": 564.24,
    "end": 568.54,
    "text": "lại hay làm việc bố thí cúng giường, nhất là đối với kẻ tàn",
    "type": "speech",
    "scene_id": "S0136",
    "index": 136
  },
  {
    "start": 568.54,
    "end": 571.92,
    "text": "tịch. Nàng hết sức thương mến và tận tâm chăm sóc,",
    "type": "speech",
    "scene_id": "S0137",
    "index": 137
  },
  {
    "start": 571.92,
    "end": 574.7,
    "text": "người chồng lại có tánh bọn sẹn.",
    "type": "speech",
    "scene_id": "S0138",
    "index": 138
  },
  {
    "start": 574.7,
    "end": 577.9,
    "text": "Mỗi khi thấy vợ làm việc cúng giường bố thí,",
    "type": "speech",
    "scene_id": "S0139",
    "index": 139
  },
  {
    "start": 577.9,
    "end": 581.4,
    "text": "thì tỏ ra thái độ bất bằng, tìm cách ngăn cản.",
    "type": "speech",
    "scene_id": "S0140",
    "index": 140
  },
  {
    "start": 581.4,
    "end": 586.0,
    "text": "Một hôm gặp ngày nguyên đáng, người vợ thành tâm sắm sữa lễ vật",
    "type": "speech",
    "scene_id": "S0141",
    "index": 141
  },
  {
    "start": 586.0,
    "end": 589.4,
    "text": "để cúng dường tam bảo và bố thí kẻ nghèo",
    "type": "speech",
    "scene_id": "S0142",
    "index": 142
  },
  {
    "start": 589.4,
    "end": 593.16,
    "text": "trong ba ngày. Người chồng thấy vậy bực tức nói rằng,",
    "type": "speech",
    "scene_id": "S0143",
    "index": 143
  },
  {
    "start": 593.16,
    "end": 597.44,
    "text": "hãy để dành tiền của lại sắm sữa thêm nhà, cửa, ruộng đất,",
    "type": "speech",
    "scene_id": "S0144",
    "index": 144
  },
  {
    "start": 597.44,
    "end": 601.94,
    "text": "chứ làm những việc ấy thêm hao tốn, phọng có ích gì.",
    "type": "speech",
    "scene_id": "S0145",
    "index": 145
  },
  {
    "start": 601.94,
    "end": 606.24,
    "text": "Người vợ dịu dàng trả lời, của cãi là vật vô thường ta không",
    "type": "speech",
    "scene_id": "S0146",
    "index": 146
  },
  {
    "start": 606.24,
    "end": 610.46,
    "text": "bỏ nó, rồi nó sẽ bỏ ta hơn nữa những kẻ nghèo khổ hiện",
    "type": "speech",
    "scene_id": "S0147",
    "index": 147
  },
  {
    "start": 610.46,
    "end": 614.76,
    "text": "tại. Theo trong Kinh Phật dạy, đều do đời trước tham lam",
    "type": "speech",
    "scene_id": "S0148",
    "index": 148
  },
  {
    "start": 614.76,
    "end": 618.94,
    "text": "ích kỷ, không biết dùng tiền của làm các việc phước thiện ngày",
    "type": "speech",
    "scene_id": "S0149",
    "index": 149
  },
  {
    "start": 618.94,
    "end": 623.12,
    "text": "nay đời sống của vợ chồng chúng ta. Tạm gọi là khá giả.",
    "type": "speech",
    "scene_id": "S0150",
    "index": 150
  },
  {
    "start": 623.12,
    "end": 627.22,
    "text": "Chúng ta nên dùng một số tiền làm các việc phước thiện",
    "type": "speech",
    "scene_id": "S0151",
    "index": 151
  },
  {
    "start": 627.22,
    "end": 630.32,
    "text": "để bảo tồn hạnh phục tương lai cho chúng ta.",
    "type": "speech",
    "scene_id": "S0152",
    "index": 152
  },
  {
    "start": 630.32,
    "end": 634.5,
    "text": "Và cũng gọi là góp một phần trong công việc nghĩa chung vậy.",
    "type": "speech",
    "scene_id": "S0153",
    "index": 153
  },
  {
    "start": 634.5,
    "end": 638.84,
    "text": "Nghe mấy lời giải thích của vợ, người lái buôn mới tỉnh ngộ",
    "type": "speech",
    "scene_id": "S0154",
    "index": 154
  },
  {
    "start": 638.84,
    "end": 643.5,
    "text": "và cảm động. Từ đó anh không ngăn cản vợ mà lại rất hăng",
    "type": "speech",
    "scene_id": "S0155",
    "index": 155
  },
  {
    "start": 643.5,
    "end": 647.32,
    "text": "hái trong công việc làm phước đức. Này Đại Vương,",
    "type": "speech",
    "scene_id": "S0156",
    "index": 156
  },
  {
    "start": 647.32,
    "end": 651.42,
    "text": "vợ người lái buôn xưa kia chính là công chúa Nhật Quang ngày",
    "type": "speech",
    "scene_id": "S0157",
    "index": 157
  },
  {
    "start": 651.42,
    "end": 655.74,
    "text": "nay. Đời trước nàng thường khuyến khích mọi người bỏ ác làm lành.",
    "type": "speech",
    "scene_id": "S0158",
    "index": 158
  },
  {
    "start": 655.74,
    "end": 659.74,
    "text": "Quy y tam bảo nên được quả báo thông minh suốt chúng",
    "type": "speech",
    "scene_id": "S0159",
    "index": 159
  },
  {
    "start": 659.74,
    "end": 663.08,
    "text": "đời trước sốt sắn cúng dường bố thí.",
    "type": "speech",
    "scene_id": "S0160",
    "index": 160
  },
  {
    "start": 663.08,
    "end": 665.78,
    "text": "Nên nay được quả báo sung sướng giàu sang.",
    "type": "speech",
    "scene_id": "S0161",
    "index": 161
  },
  {
    "start": 665.78,
    "end": 669.74,
    "text": "Nhiều người mến phục đời trước tận tâm săn sóc giúp",
    "type": "speech",
    "scene_id": "S0162",
    "index": 162
  },
  {
    "start": 669.74,
    "end": 675.04,
    "text": "đỡ kẻ tàn tật Ngày nay được quả báo nhan sắc đẹp đẻ Tướng Mạo",
    "type": "speech",
    "scene_id": "S0163",
    "index": 163
  },
  {
    "start": 675.04,
    "end": 679.42,
    "text": "Đoan Trang Người lái buôn xưa kia chính là chồng công chúa hiện",
    "type": "speech",
    "scene_id": "S0164",
    "index": 164
  },
  {
    "start": 679.42,
    "end": 683.66,
    "text": "tại Ngày trước lúc chưa tỉnh ngộ Anh ta bỏng sẻn",
    "type": "speech",
    "scene_id": "S0165",
    "index": 165
  },
  {
    "start": 683.66,
    "end": 688.36,
    "text": "hay ngăn cản việc làm phước thiện của vợ Nên ngày nay phải chịu đói",
    "type": "speech",
    "scene_id": "S0166",
    "index": 166
  },
  {
    "start": 688.36,
    "end": 692.6,
    "text": "rách một thời Vua Ba Tư nạc nghe Phật kể rõ tiền kiếp",
    "type": "speech",
    "scene_id": "S0167",
    "index": 167
  },
  {
    "start": 692.6,
    "end": 697.18,
    "text": "của công chúa Nhật Quang Nhà vua mới tỉnh ngộ và rất thâm cảm",
    "type": "speech",
    "scene_id": "S0168",
    "index": 168
  },
  {
    "start": 697.18,
    "end": 701.9,
    "text": "đạo lý nhân quả tội phước của Phật Rồi vua cuối đầu đảnh lễ đức",
    "type": "speech",
    "scene_id": "S0169",
    "index": 169
  },
  {
    "start": 701.9,
    "end": 706.24,
    "text": "Phật ra về Về đến cung, công việc đầu tiên của vua",
    "type": "speech",
    "scene_id": "S0170",
    "index": 170
  },
  {
    "start": 706.24,
    "end": 709.96,
    "text": "là cho người đón rước vợ chồng công chúa Nhật Quang",
    "type": "speech",
    "scene_id": "S0171",
    "index": 171
  },
  {
    "start": 709.96,
    "end": 714.24,
    "text": "về Gặp công chúa, vua Ba Tư nặc hôn siết vui mừng",
    "type": "speech",
    "scene_id": "S0172",
    "index": 172
  },
  {
    "start": 714.24,
    "end": 718.32,
    "text": "Vua không quên nói nhiều lời hối hận Với công chúa Nhật Quang",
    "type": "speech",
    "scene_id": "S0173",
    "index": 173
  },
  {
    "start": 718.32,
    "end": 722.88,
    "text": "cũng rất sung sướng được gần gũi phụng sự cha mẹ và giúp vua cha",
    "type": "speech",
    "scene_id": "S0174",
    "index": 174
  },
  {
    "start": 722.88,
    "end": 726.34,
    "text": "trong việc trao dồi đạo đức, bảo quốc an dân.",
    "type": "speech",
    "scene_id": "S0175",
    "index": 175
  },
  {
    "start": 726.34,
    "end": 729.68,
    "text": "Thanh niên hành khất chồng công chúa",
    "type": "speech",
    "scene_id": "S0176",
    "index": 176
  },
  {
    "start": 729.68,
    "end": 733.02,
    "text": "cũng được vua phong cho một chức quan",
    "type": "speech",
    "scene_id": "S0177",
    "index": 177
  }
]