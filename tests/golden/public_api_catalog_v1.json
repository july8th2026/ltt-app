{
  "tools": [
    {
      "name": "image.generate",
      "capability": "image",
      "description": "Generate one to four images from a text prompt, optionally guided by one reference image.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "description": "What to draw. Everything about the image comes from this text.",
            "examples": [
              "a paper boat on a rain-soaked street at night"
            ]
          },
          "image_key": {
            "type": "string",
            "description": "Optional reference image, given as the id of an upload you confirmed or of an artifact from an earlier job. The result follows its subject and composition.",
            "examples": [
              "upl_from_POST_/api/v1/uploads"
            ]
          },
          "model": {
            "type": "string",
            "enum": [
              "enhanced",
              "pro",
              "standard",
              "standard-lite"
            ],
            "description": "Quality tier. This is what the price depends on — see the model list for what each alias is for.",
            "examples": [
              "standard"
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4"
            ],
            "default": "16:9",
            "description": "Shape of the output image.",
            "examples": [
              "16:9"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "How many images to generate. Each one is charged.",
            "examples": [
              1
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "prompt"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "image_keys": {
            "type": "artifact[]"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "required_scopes": [
        "jobs:create"
      ],
      "contract_hash": "f6fd70a8e5a91489"
    },
    {
      "name": "image.ltt",
      "capability": "image",
      "description": "Generate images with LTT Studios' own model. Supports text-to-image, instruction editing of a reference image, and keeping the same subject across a new scene.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "description": "What to draw. Written in any language - the platform translates it to English before the model sees it, because this model only understands English and Chinese. Text you want DRAWN INSIDE the image must be in double quotes; it is kept exactly as written.",
            "examples": [
              "A calico cat sleeping on a windowsill, afternoon light"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "t2i",
              "edit",
              "subject"
            ],
            "default": "t2i",
            "description": "t2i = from text only. edit = change one reference image while keeping the rest. subject = keep the same person or object across a new scene. Both need image_key, and both cost three times more because they take about three times as long.",
            "examples": [
              "t2i"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "How many images to return, 1 to 4.",
            "examples": [
              1
            ]
          },
          "image_key": {
            "type": "string",
            "description": "Reference image, given as the id of an upload you confirmed or of an artifact from an earlier job. Required for edit and subject; ignored for t2i.",
            "examples": [
              "upl_from_POST_/api/v1/uploads"
            ]
          },
          "negative_prompt": {
            "type": "string",
            "maxLength": 1000,
            "description": "What to avoid. Optional.",
            "examples": [
              ""
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "prompt"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "image_keys": {
            "type": "artifact[]"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "required_scopes": [
        "jobs:create"
      ],
      "contract_hash": "93dbcde993e11c2b"
    },
    {
      "name": "image.thumbnail",
      "capability": "image",
      "description": "Generate one to four YouTube thumbnail images from a topic, with optional title text, style and language.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the thumbnail is about. The whole image is generated from this, so be specific about subject and mood.",
            "examples": [
              "How to fix a leaking tap in 5 minutes"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "description": "Large text drawn on the image. Leave empty for an image with no text.",
            "examples": [
              "5 MINUTE FIX"
            ]
          },
          "subtitle": {
            "type": "string",
            "maxLength": 200,
            "description": "Smaller supporting line under the title.",
            "examples": [
              "no plumber needed"
            ]
          },
          "text_style": {
            "type": "string",
            "enum": [
              "bold_impact",
              "clean_minimal",
              "dramatic_gold",
              "neon_glow",
              "street_art"
            ],
            "description": "How the text is drawn. Ignored when both title and subtitle are empty.",
            "examples": [
              "bold_impact"
            ]
          },
          "phong_cach": {
            "type": "string",
            "enum": [
              "chuyen_nghiep_toi_gian",
              "hoat_hinh_cartoon",
              "cinematic",
              "flat_design",
              "3d_render",
              "collage",
              "retro_vintage"
            ],
            "description": "Visual style of the image itself. The name is Vietnamese because it is a stable identifier, not a label; the values are listed in `enum`.",
            "examples": [
              "cinematic"
            ]
          },
          "kieu_trend": {
            "type": "string",
            "enum": [
              "khuon_mat_cam_xuc",
              "so_sanh_truoc_sau",
              "bi_an_gay_to_mo",
              "listicle_numbered",
              "huong_dan_tutorial",
              "reaction_phan_ung",
              "storytelling",
              "mui_ten_chi_dan",
              "text_heavy_chu_lon"
            ],
            "description": "Composition pattern — what makes the thumbnail work as a thumbnail (a reacting face, a before/after split, a numbered list, and so on).",
            "examples": [
              "khuon_mat_cam_xuc"
            ]
          },
          "ngon_ngu": {
            "type": "string",
            "enum": [
              "tieng_viet",
              "english",
              "japanese",
              "korean",
              "chinese"
            ],
            "description": "Language of the text drawn on the image.",
            "examples": [
              "english"
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4"
            ],
            "default": "16:9",
            "description": "Shape of the output. 16:9 is the YouTube thumbnail shape.",
            "examples": [
              "16:9"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "How many variations to generate. Each one is charged, so a quote for count=4 costs four times a quote for count=1.",
            "examples": [
              2
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "topic"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "image_keys": {
            "type": "artifact[]"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "required_scopes": [
        "jobs:create"
      ],
      "contract_hash": "f1894755c0b48b16"
    },
    {
      "name": "image.upscale",
      "capability": "image",
      "description": "Upscale an image to four times its original size. Costs 2 credits at the fast preset and 4 at the quality preset.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "image_key": {
            "type": "string",
            "description": "The image to enlarge, given as the id of an upload you confirmed or of an artifact from an earlier job.",
            "examples": [
              "upl_from_POST_/api/v1/uploads"
            ]
          },
          "preset": {
            "type": "string",
            "enum": [
              "fast",
              "quality"
            ],
            "default": "fast",
            "description": "How hard to work on the result. `fast` costs 2 credits, `quality` costs 4 and takes longer.",
            "examples": [
              "fast"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "image_key"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "image_key": {
            "type": "artifact"
          }
        }
      },
      "required_scopes": [
        "jobs:create"
      ],
      "contract_hash": "917d9f5da2fe9a80"
    },
    {
      "name": "story.storyboard",
      "capability": "story",
      "description": "Turn a story brief into a storyboard: one shot description per scene plus a master prompt. Priced by scene count.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "description": "Working title of the piece. Used for tone and for naming the result.",
            "examples": [
              "The last train home"
            ]
          },
          "story": {
            "type": "string",
            "maxLength": 12000,
            "description": "The story or brief, in prose. This is the source everything else is derived from.",
            "examples": [
              "A courier misses the last train and walks the city until dawn."
            ]
          },
          "scene_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 6,
            "description": "How many scenes to produce. This is what the price depends on.",
            "examples": [
              6
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "21:9"
            ],
            "default": "16:9",
            "description": "Shape the scenes are written for; it changes framing advice, not the file.",
            "examples": [
              "16:9"
            ]
          },
          "style": {
            "type": "string",
            "maxLength": 500,
            "description": "Visual or narrative style to aim for, in your own words.",
            "examples": [
              "neo-noir, heavy rain, neon reflections"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "story",
          "title"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "storyboard": {
            "type": "object"
          },
          "master_prompt": {
            "type": "string"
          }
        }
      },
      "required_scopes": [
        "jobs:create"
      ],
      "contract_hash": "9c7cfd84114e0c1b"
    },
    {
      "name": "text.prompt_package",
      "capability": "text",
      "description": "Turn a story brief into a structured prompt package: one prompt per scene plus a master prompt. Priced by scene count.",
      "execution_mode": "ASYNC_JOB",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "description": "Working title of the piece. Used for tone and for naming the result.",
            "examples": [
              "The last train home"
            ]
          },
          "story": {
            "type": "string",
            "maxLength": 12000,
            "description": "The story or brief, in prose. This is the source everything else is derived from.",
            "examples": [
              "A courier misses the last train and walks the city until dawn."
            ]
          },
          "scene_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 6,
            "description": "How many scenes to produce. This is what the price depends on.",
            "examples": [
              6
            ]
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 600,
            "default": 30,
            "description": "Target length of the finished piece. Scenes are paced to fit it.",
            "examples": [
              45
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "21:9"
            ],
            "default": "16:9",
            "description": "Shape the scenes are written for; it changes framing advice, not the file.",
            "examples": [
