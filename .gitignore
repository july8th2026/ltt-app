# Ho so van hanh CUA MOT CAY (tools/ho_so_cay.py). Cho dung cua no la
# `.git/worktrees/<ten>/ltt_ho_so.json` - tuc git khong bao gio thay no. Dong
# nay chan ban sao dat NHAM cho: trang thai cua mot phien khong duoc di theo
# `robocopy` cua deploy, va khong duoc commit vao mot nhanh ma cay khac cung
# checkout. Chot: tests/test_1100_ho_so_cay.py
ltt_ho_so.json

# ─── Weight cua evaluator Quality Lab — CAP BANG TAC VU OPERATOR ────────────
#
# `apps/qualitylab/evaluator_assets.py` doi weight duoc cap SAN NGOAI RUNTIME
# kem SHA-256; worker khong duoc tai mang. Nen chung nam o `data/`, khong o
# trong git: mot backbone AlexNet la ~233 MB, va mot kho co weight trong lich
# su thi khong bao gio nho lai duoc.
#
# ⛔ Va co mot ly do thu hai, dat hon: `data/` KHONG bi ignore theo mac dinh,
#    nen mot tep 233 MB tha vao day se hien trong `git status`. Deploy chep CA
#    CAY, ke ca phan chua commit (Bay 30) — tuc no se len may chu ma khong
#    thuoc commit nao.
data/qualitylab/models/

# Worker list (operator's own sheet/page configuration, machine-specific)
data/workers.json

# Audit log (may contain PII)
data/audit_log.jsonl
# LTT Nexus: ban cai + manifest la DU LIEU VAN HANH (dat tren server,
# khong nhoi binary vao git; manifest thieu binary = link vo). Deploy rieng.
data/nexus_dist/
# Bo cai cong cu cam (~25 MB). Cung ly do voi nexus_dist: nhi phan phat hanh
# khong nam trong kho ma, no duoc tha vao thu muc van hanh tren may chu.
data/api_dist/
data/nexus_versions.json
# LTTCODE: bo cai da ky + manifest kenh phat hanh, do tools/release.ps1 (kho
# LTTCODEAPP) ghi vao thu muc du lieu van hanh. Khong commit.
data/lttcode_dist/
data/lttcode_releases.json

