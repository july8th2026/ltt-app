{
  "info": {
    "description": "Sinh tu OpenAPI bang `python tools/build_postman.py`. DUNG sua tay: lan sinh sau se ghi de, va mot collection sua tay la ban sao thu hai cua hop dong.",
    "name": "LTT Public API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /artifacts/{artifact_id}",
      "request": {
        "description": "Returns a time-limited URL for one output of a job this account owns. Outputs are kept for 30 days after the job finishes, then deleted; the job itself stays available for billing reconciliation.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "artifacts",
            "{artifact_id}"
          ],
          "raw": "{{base_url}}/artifacts/{{artifact_id}}"
        }
      }
    },
    {
      "name": "GET /artifacts/{artifact_id}/content",
      "request": {
        "description": "Streams the output when the storage backend cannot issue a signed URL. Same 30-day window as the signed URL above.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "artifacts",
            "{artifact_id}",
            "content"
          ],
          "raw": "{{base_url}}/artifacts/{{artifact_id}}/content"
        }
      }
    },
    {
      "name": "GET /capabilities",
      "request": {
        "description": "Reports the API version, whether writes are currently accepted, and the capabilities available to callers.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "capabilities"
          ],
          "raw": "{{base_url}}/capabilities"
        }
      }
    },
    {
      "name": "GET /credits/balance",
      "request": {
        "description": "The account's credit balance, from the credit ledger.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "credits",
            "balance"
          ],
          "raw": "{{base_url}}/credits/balance"
        }
      }
    },
    {
      "name": "GET /health",
      "request": {
        "description": "Returns ok while this API surface is serving requests.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ],
          "raw": "{{base_url}}/health"
        }
      }
    },
    {
      "name": "GET /jobs",
      "request": {
        "description": "Owner-scoped, newest first, with optional status filter.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs"
          ],
          "raw": "{{base_url}}/jobs"
        }
      }
    },
    {
      "name": "POST /jobs",
      "request": {
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"tool\": \"{{tool}}\",\n  \"input\": {}\n}"
        },
        "description": "Holds the quoted credit and queues the job. Requires an Idempotency-Key header.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "description": "Bat buoc. Gui lai cung mot key khi thu lai, neu khong ban se bi tinh hai lan.",
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "method": "POST",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs"
          ],
          "raw": "{{base_url}}/jobs"
        }
      }
    },
    {
      "name": "GET /jobs/{job_id}",
      "request": {
        "description": "Owner-scoped. Unknown or foreign ids answer 404.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "GET",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs",
            "{job_id}"
          ],
          "raw": "{{base_url}}/jobs/{{job_id}}"
        }
      }
    },
    {
      "name": "POST /jobs/{job_id}/cancel",
      "request": {
        "description": "Cancels a queued or running job and refunds the held credit. Repeating the call is safe.",
        "header": [
          {
            "key": "Authorization",
            "type": "text",
            "value": "Bearer {{api_key}}"
          }
        ],
        "method": "POST",
        "url": {
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "jobs",
            "{job_id}",
            "cancel"
          ],
          "raw": "{{base_url}}/jobs/{{job_id}}/cancel"
        }
      }
    },
