              "language": "json"
            }
          },
          "raw": "{\n  \"tool\": \"{{tool}}\",\n  \"input\": {}\n}"
        },
        "description": "Returns a signed quote bound to this account, tool and input. Submit it to POST /jobs to run the call.",
