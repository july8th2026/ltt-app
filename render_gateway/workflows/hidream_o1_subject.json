{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "@ckpt"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "1",
        1
      ],
      "text": "@prompt"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "1",
        1
      ],
      "text": "@negative"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "@ref1"
    }
  },
  "9": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "8",
        0
      ],
      "upscale_method": "@upscale",
      "megapixels": "@ref_mp",
      "resolution_steps": 32
    }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "@ref2"
    }
  },
  "12": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "upscale_method": "@upscale",
      "megapixels": "@ref_mp",
      "resolution_steps": 32
    }
  },
  "10": {
    "class_type": "HiDreamO1ReferenceImages",
    "inputs": {
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "images.image_1": [
        "9",
        0
      ],
      "images.image_2": [
        "12",
        0
      ]
    }
  },
  "4": {
    "class_type": "EmptyHiDreamO1LatentImage",
    "inputs": {
      "width": "@width",
      "height": "@height",
      "batch_size": "@batch"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "21",
        0
      ],
      "positive": [
        "10",
        0
      ],
      "negative": [
        "10",
        1
      ],
      "latent_image": [
        "4",
        0
      ],
      "seed": "@seed",
      "steps": "@steps",
      "cfg": "@cfg",
      "sampler_name": "@sampler",
      "scheduler": "@scheduler",
      "denoise": 1.0
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "filename_prefix": "@prefix"
    }
  },
  "20": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": "@shift"
    }
  },
  "21": {
    "class_type": "HiDreamO1PatchSeamSmoothing",
    "inputs": {
      "model": [
        "20",
        0
      ],
      "start_percent": "@seam_start",
      "end_percent": 1.0,
      "pattern": "@seam_pattern",
      "passes": "@seam_passes",
      "blend": "average",
      "strength": "@seam_strength"
    }
  }
}
